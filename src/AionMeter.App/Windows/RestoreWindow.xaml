<Window x:Class="AionMeter.App.Windows.RestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:AionMeter.App.Services"
        Title="{Binding RestoreTitle, Source={x:Static s:UiText.Current}}" Width="520" SizeToContent="Height"
        WindowStyle="None" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource Bg0}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}" FontSize="12.5">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource GoldDim}" BorderThickness="1" Padding="20,10,20,16">
        <StackPanel>
            <Grid Height="34">
                <TextBlock Text="{Binding RestoreTitle, Source={x:Static s:UiText.Current}}" FontFamily="{StaticResource TitleFont}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,4,0,12" Text="{Binding RestoreIntro, Source={x:Static s:UiText.Current}}" />
            <DockPanel>
                <Button x:Name="RestoreButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" MinWidth="90" Click="Restore_Click"
                        Content="{Binding RestoreGo, Source={x:Static s:UiText.Current}}" />
                <TextBox x:Name="CodeBox" Style="{StaticResource Field}" Height="30" FontFamily="Consolas" FontSize="13.5" KeyDown="CodeBox_KeyDown"
                         ToolTip="XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX" />
            </DockPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource TextDim}" MinHeight="18" />
        </StackPanel>
    </Border>
</Window>
