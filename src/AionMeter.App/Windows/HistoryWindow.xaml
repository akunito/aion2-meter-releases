<Window x:Class="AionMeter.App.Windows.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AionMeter.App.Controls"
        xmlns:s="clr-namespace:AionMeter.App.Services"
        Title="{Binding WinHistoryTitle, Source={x:Static s:UiText.Current}}" Width="900" Height="600" MinWidth="640" MinHeight="380"
        WindowStyle="None" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="{StaticResource Bg0}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <c:VisibleIf x:Key="VisibleIf" />
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ListItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Padding="10,7" Margin="0,1" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverFill}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26C9A45C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource GoldDim}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="18,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding YourFights, Source={x:Static s:UiText.Current}}" FontFamily="{StaticResource TitleFont}" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock x:Name="CountText" Margin="12,4,18,0" FontFamily="{StaticResource NumberFont}" FontSize="12"
                               Foreground="{StaticResource TextMute}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <RadioButton x:Name="FilterAll" Style="{StaticResource TabToggle}" Content="{Binding FilterAll, Source={x:Static s:UiText.Current}}" IsChecked="True" Checked="Filter_Changed" />
                        <RadioButton x:Name="FilterBosses" Style="{StaticResource TabToggle}" Content="{Binding FilterBosses, Source={x:Static s:UiText.Current}}" Checked="Filter_Changed" />
                        <RadioButton x:Name="FilterKills" Style="{StaticResource TabToggle}" Content="{Binding FilterKills, Source={x:Static s:UiText.Current}}" Checked="Filter_Changed" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Click="Refresh_Click" ToolTip="{Binding TipRefresh, Source={x:Static s:UiText.Current}}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE838;" Click="OpenFolder_Click" ToolTip="{Binding TipOpenFolder, Source={x:Static s:UiText.Current}}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Click="Delete_Click" ToolTip="{Binding TipDelete, Source={x:Static s:UiText.Current}}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" Click="Close_Click" ToolTip="{Binding TipClose, Source={x:Static s:UiText.Current}}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ListBox x:Name="Fights" Background="{StaticResource Bg1}" Foreground="{StaticResource Text}" BorderThickness="0" Padding="6"
                         ItemContainerStyle="{StaticResource ListItem}" SelectionChanged="Fights_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <c:BossPortrait Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center" Source="{Binding Portrait}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ResultGlyph}" Foreground="{Binding ResultBrush}" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Cell}" FontSize="11" Foreground="{StaticResource TextMute}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Dps}" Style="{StaticResource Cell}" FontSize="13" Foreground="{StaticResource GoldBright}"
                                                   FontWeight="SemiBold" />
                                        <Border Width="19" Height="19" Margin="6,0,0,0" CornerRadius="5" Background="{Binding PlaceBg}"
                                                BorderBrush="{Binding PlaceBorder}" BorderThickness="1" Visibility="{Binding PlaceVisibility}"
                                                ToolTip="{Binding YourPlace, Source={x:Static s:UiText.Current}}">
                                            <TextBlock Text="{Binding Place}" FontFamily="{StaticResource NumberFont}" FontSize="10.5" FontWeight="Bold"
                                                       Foreground="{Binding PlaceFg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding When}" Style="{StaticResource Cell}" FontSize="11" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Column="1" Margin="18,10,18,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid Margin="0,0,170,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:BossPortrait x:Name="DetailPortrait" Width="58" Height="58" Margin="0,0,14,0" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="DetailTitle" FontFamily="{StaticResource TitleFont}" FontSize="20" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="DetailMeta" Style="{StaticResource Cell}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Click="ShowInOverlay_Click" ToolTip="{Binding TipShowInOverlay, Source={x:Static s:UiText.Current}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" />
                                <TextBlock Text="{Binding ShowInOverlay, Source={x:Static s:UiText.Current}}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="Party">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="32" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonUp="Member_Click" Background="Transparent"
                                          ToolTip="{Binding TipOpenBreakdown, Source={x:Static s:UiText.Current}}">
                                        <Border CornerRadius="7" Background="{StaticResource RowTrack}" />
                                        <Border CornerRadius="7" Background="{Binding FillBrush}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding Fill}" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <Border CornerRadius="7" BorderThickness="1.6" BorderBrush="{StaticResource GoldBright}"
                                                Visibility="{Binding IsSelf, Converter={StaticResource VisibleIf}}" />
                                        <Grid Margin="6,0,12,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="22" Height="22" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Background="{Binding RankBackground}" BorderBrush="{Binding RankBorder}" BorderThickness="1">
                                                <TextBlock Text="{Binding RankText}" FontFamily="{StaticResource NumberFont}" FontSize="12.5" FontWeight="Bold"
                                                           Foreground="{Binding RankForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <c:ClassGlyph Grid.Column="1" Class="{Binding Class}" Width="22" Height="22" HorizontalAlignment="Left" OnBar="True" />
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Dps}" Style="{StaticResource Cell}" FontSize="13.5"
                                                       Foreground="{Binding DpsBrush}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="4" Text="{Binding Damage}" Style="{StaticResource Cell}" Foreground="{StaticResource Text}"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="5" Text="{Binding Share}" Style="{StaticResource Cell}" Foreground="{StaticResource Text}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyText" Grid.Row="1" Text="{Binding HistoryEmpty, Source={x:Static s:UiText.Current}}" Foreground="{StaticResource TextMute}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
