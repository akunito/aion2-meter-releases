<Window x:Class="AionMeter.App.Windows.BugReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:AionMeter.App.Services"
        Title="{Binding ReportTitle, Source={x:Static s:UiText.Current}}" Width="520" Height="440" MinWidth="420" MinHeight="360"
        WindowStyle="None" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="{StaticResource Bg0}"
        Topmost="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}" FontSize="12.5">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource GoldDim}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="18,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xEBE8;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{StaticResource Amber}" VerticalAlignment="Center" Margin="0,2,10,0" />
                    <TextBlock Text="{Binding ReportTitle, Source={x:Static s:UiText.Current}}" FontFamily="{StaticResource TitleFont}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>
            <TextBlock Grid.Row="1" x:Name="Intro" Margin="20,0,20,10" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Text="{Binding ReportHint, Source={x:Static s:UiText.Current}}" />
            <TextBox Grid.Row="2" x:Name="NoteBox" Margin="20,0,20,10" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Background="#1A1F2E" Foreground="{StaticResource Text}" BorderBrush="{StaticResource GoldDim}" BorderThickness="1" Padding="8,6"
                     ToolTip="{Binding ReportDescribe, Source={x:Static s:UiText.Current}}" />
            <StackPanel Grid.Row="3" Margin="20,0,20,10">
                <CheckBox x:Name="IncludeState" Style="{StaticResource DarkCheck}" Content="{Binding ReportIncludeState, Source={x:Static s:UiText.Current}}" />
                <TextBlock x:Name="State" FontSize="11.5" Foreground="{StaticResource TextDim}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
            <Border Grid.Row="4" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Click="Close_Click" Margin="0,0,8,0" Content="{Binding UpdateLater, Source={x:Static s:UiText.Current}}" />
                    <Button x:Name="CreateButton" Style="{StaticResource PrimaryButton}" Click="Create_Click" Content="{Binding ReportCreate, Source={x:Static s:UiText.Current}}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
