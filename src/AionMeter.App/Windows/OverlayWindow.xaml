<Window x:Class="AionMeter.App.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AionMeter.App.Controls"
        xmlns:vm="clr-namespace:AionMeter.App.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:s="clr-namespace:AionMeter.App.Services"
        x:Name="Root"
        Title="AION2 DPS Meter" Width="470" Height="540" MinWidth="340" MinHeight="220"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <c:VisibleIf x:Key="VisibleIf" />

        <Storyboard x:Key="Pulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.8" />
        </Storyboard>

        <!-- Row size (Settings → Overlay → Row size, Ctrl + wheel over the rows): OverlayWindow.ApplyRowSize replaces
             these. The value columns are as wide as their widest value (shared size groups with the header labels), so the
             name gets all the room that is left. -->
        <GridLength x:Key="ColRankWidth">30</GridLength>
        <GridLength x:Key="ColGlyphWidth">32</GridLength>
        <Thickness x:Key="ColGap">10,0,0,0</Thickness>
        <GridLength x:Key="ColRuleWidth">12</GridLength>
        <Thickness x:Key="RuleMargin">0,8,0,8</Thickness>
        <sys:Double x:Key="NameMaxWidth">220</sys:Double>
        <sys:Double x:Key="RowHeight">42</sys:Double>
        <Thickness x:Key="RowMargin">0,0,0,6</Thickness>
        <sys:Double x:Key="RowGlossHeight">19</sys:Double>
        <sys:Double x:Key="RowNameFont">16.5</sys:Double>
        <sys:Double x:Key="RowGearFont">14</sys:Double>
        <sys:Double x:Key="RowNumberFont">16</sys:Double>
        <sys:Double x:Key="RowGlyphSize">30</sys:Double>
        <sys:Double x:Key="RowRankSize">24</sys:Double>
        <sys:Double x:Key="RowRankFont">13</sys:Double>
        <sys:Double x:Key="ColHeaderFont">11</sys:Double>

        <!-- Dense dark halo under every text so it stays readable over any game scene -->
        <DropShadowEffect x:Key="TextShadow" BlurRadius="5" ShadowDepth="1.5" Direction="300" Opacity="1" Color="Black" />

        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource ColHeaderFont}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#C9D0DC" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Help" />
        </Style>

        <!-- DPS, total damage and share: one size, white -->
        <Style x:Key="RowNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="FontSize" Value="{DynamicResource RowNumberFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="{DynamicResource ColGap}" />
        </Style>

        <!-- Gear score and combat power: the player's own numbers, a little smaller and softer than the fight's -->
        <Style x:Key="RowGear" TargetType="TextBlock" BasedOn="{StaticResource RowNumber}">
            <Setter Property="FontSize" Value="{DynamicResource RowGearFont}" />
            <Setter Property="Foreground" Value="#E8ECF4" />
        </Style>

        <!-- The hover toolbar's buttons, sized to the slim label row -->
        <Style x:Key="ToolIcon" TargetType="ButtonBase" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource IconToggle}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- A header label over a value column: same gap as the values, so it lines up with them -->
        <Style x:Key="ColValueHeader" TargetType="TextBlock" BasedOn="{StaticResource ColHeader}">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="{DynamicResource ColGap}" />
        </Style>

        <SolidColorBrush x:Key="Cream" Color="#F3E6C8" />
        <SolidColorBrush x:Key="Soft" Color="#C3CAD8" />

        <LinearGradientBrush x:Key="CardFrame" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#6E5B36" Offset="0" />
            <GradientStop Color="#2E2A26" Offset="0.35" />
            <GradientStop Color="#24252C" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TopHitBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFF0BF" Offset="0" />
            <GradientStop Color="#F2C25A" Offset="0.55" />
            <GradientStop Color="#D99A2E" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HpFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F67A6C" Offset="0" />
            <GradientStop Color="#E0473F" Offset="0.5" />
            <GradientStop Color="#B8202A" Offset="1" />
        </LinearGradientBrush>

        <TextDecorationCollection x:Key="SelfUnderline">
            <TextDecoration Location="Underline" PenOffset="3">
                <TextDecoration.Pen>
                    <Pen Brush="#ECCB82" Thickness="1.6" />
                </TextDecoration.Pen>
            </TextDecoration>
        </TextDecorationCollection>

        <Style x:Key="FooterLink" TargetType="Button">
            <Setter Property="Foreground" Value="#D9B56A" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="14,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="P" VerticalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFE3A6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The footer's boss timer button: a filled gold pill so it reads as a button, not a link -->
        <Style x:Key="TimersPill" TargetType="Button">
            <Setter Property="Foreground" Value="#1A140A" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="11" Padding="10,3,11,3" BorderThickness="1" BorderBrush="#FFE3A6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#F3D58F" Offset="0" />
                                    <GradientStop Color="#C99A45" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.55" Color="#E9A93C" />
                            </Border.Effect>
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Recurring event pill: colour comes from the item (EventPill.Fill / Stroke), right-click opens the alert toggles -->
        <Style x:Key="EventPill" TargetType="Button">
            <Setter Property="Foreground" Value="#F4F1E8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="11" Padding="10,3,11,3" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tool pills (Atlas, Top): outlined, not filled, so they do not read as timers -->
        <Style x:Key="ToolPill" TargetType="Button">
            <Setter Property="Foreground" Value="#F3D58F" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="11" Padding="10,3,11,3" BorderThickness="1" BorderBrush="#C9A45C" Background="#99111726">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFE3A6" />
                                <Setter TargetName="Bd" Property="Background" Value="#CC1A2235" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "A new version is out": a slim green banner above the footer, only while an update is available -->
        <Style x:Key="UpdateBannerButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D2FAE6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="10,4,10,4" BorderThickness="1" BorderBrush="#803DD68C" Background="#2A3DD68C">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3DD68C" />
                                <Setter TargetName="Bd" Property="Background" Value="#403DD68C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One player: a full-height class-coloured bar (AionFlex style) with place medal, emblem, name,
             DPS in a light class tint, total damage and share -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:RowViewModel}">
            <Grid Height="{DynamicResource RowHeight}" Margin="{DynamicResource RowMargin}" Cursor="Hand" ToolTip="{Binding Tooltip}"
                  Background="Transparent" MouseLeftButtonUp="Row_Click" MouseRightButtonUp="Row_RightClick">
                <!-- track -->
                <Border CornerRadius="7">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#2A3046" Offset="0" />
                            <GradientStop Color="#20253A" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <!-- fill -->
                <Border CornerRadius="7" Background="{Binding FillBrush}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding Fill}" />
                    </Border.RenderTransform>
                </Border>
                <!-- gloss on the upper half -->
                <Border CornerRadius="7,7,0,0" Height="{DynamicResource RowGlossHeight}" VerticalAlignment="Top" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#22FFFFFF" Offset="0" />
                            <GradientStop Color="#05FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border x:Name="Hover" CornerRadius="7" BorderThickness="1" BorderBrush="Transparent" />
                <!-- your own row -->
                <Border CornerRadius="7" BorderThickness="1.6" BorderBrush="{StaticResource GoldBright}"
                        Visibility="{Binding IsSelf, Converter={StaticResource VisibleIf}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.8" Color="#E7C67F" />
                    </Border.Effect>
                </Border>

                <!-- The player (name, gear score, combat power) on the left; a rule; the fight's numbers on the right -->
                <Grid Margin="8,0,14,0" Effect="{StaticResource TextShadow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource ColRankWidth}" />
                        <ColumnDefinition Width="{DynamicResource ColGlyphWidth}" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Gs" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Cp" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{DynamicResource ColRuleWidth}" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Dps" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Damage" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Share" />
                    </Grid.ColumnDefinitions>

                    <!-- Place: medal for the top three, ringed number for the rest -->
                    <Grid Width="{DynamicResource RowRankSize}" Height="{DynamicResource RowRankSize}" HorizontalAlignment="Left"
                          VerticalAlignment="Center">
                        <Ellipse Fill="{Binding RankBackground}" Stroke="{Binding RankBorder}" StrokeThickness="1.2" />
                        <TextBlock Text="{Binding RankText}" FontFamily="{StaticResource NumberFont}" FontSize="{DynamicResource RowRankFont}"
                                   FontWeight="Bold" Foreground="{Binding RankForeground}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Margin="0,0,0,1" />
                    </Grid>

                    <c:ClassGlyph Grid.Column="1" Class="{Binding Class}" OnBar="True" Width="{DynamicResource RowGlyphSize}"
                                  Height="{DynamicResource RowGlyphSize}" HorizontalAlignment="Left" />

                    <!-- As wide as the longest name, up to what the other columns leave (OverlayWindow.FitNames) -->
                    <TextBlock x:Name="NameText" Grid.Column="2" Text="{Binding Name}" FontSize="{DynamicResource RowNameFont}" FontWeight="Bold"
                               Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0,0,1"
                               MaxWidth="{DynamicResource NameMaxWidth}" />

                    <!-- Gear score and combat power, right by the name: only players of your party have them (the party roster) -->
                    <TextBlock Grid.Column="3" Text="{Binding GearScore}" Style="{StaticResource RowGear}"
                               Visibility="{Binding HasGearScore, Converter={StaticResource VisibleIf}}" />
                    <TextBlock Grid.Column="4" Text="{Binding CombatPower}" Style="{StaticResource RowGear}"
                               Visibility="{Binding HasCombatPower, Converter={StaticResource VisibleIf}}" />

                    <Rectangle Grid.Column="6" Width="1.2" Fill="#8CFFFFFF" HorizontalAlignment="Center" Margin="{DynamicResource RuleMargin}"
                               Visibility="{Binding DataContext.HasGear, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleIf}}" />

                    <TextBlock Grid.Column="7" Text="{Binding Dps}" Style="{StaticResource RowNumber}" />
                    <TextBlock Grid.Column="8" Text="{Binding Damage}" Style="{StaticResource RowNumber}" />
                    <TextBlock Grid.Column="9" Text="{Binding Share}" Style="{StaticResource RowNumber}" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Hover" Property="BorderBrush" Value="#66FFFFFF" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelf}" Value="True">
                    <Setter TargetName="NameText" Property="TextDecorations" Value="{StaticResource SelfUnderline}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <!-- Card -->
        <Border x:Name="Frame" CornerRadius="18" BorderThickness="1" BorderBrush="{StaticResource CardFrame}">
            <Border.Background>
                <SolidColorBrush x:Name="FrameBackground" Color="#0D111A" Opacity="0.92" />
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.6" Color="Black" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="18" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0DFFFFFF" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="0.4" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border Height="2" VerticalAlignment="Top" Margin="70,0" Background="{StaticResource GoldTopLine}" IsHitTestVisible="False" />

        <Grid x:Name="CardBody" Margin="18,10,18,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The one top line: the fight's title on the left (the toolbar while the mouse is over the overlay), the state
                 and the timer on the right -->
            <Grid x:Name="Header" Background="Transparent" Height="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleText" Text="{Binding Title}" FontFamily="{StaticResource TitleFont}" FontSize="16" FontWeight="SemiBold"
                           Typography.Capitals="SmallCaps" Foreground="{StaticResource Cream}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="0,0,10,0" Effect="{StaticResource TextShadow}" Background="Transparent"
                           MouseWheel="Title_MouseWheel" ToolTip="{Binding TitleTip}" />

                <StackPanel x:Name="Toolbar" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed">
                    <Button Style="{StaticResource Chip}" Content="{Binding ModeLabel}" Click="Mode_Click" Margin="0,0,5,0"
                            ToolTip="Boss only / everything you hit" />
                    <Button Style="{StaticResource Chip}" Content="{Binding LanguageCode}" Click="Language_Click" Margin="0,0,5,0"
                            ToolTip="{Binding T.SwitchLanguage}" />
                    <Button Style="{StaticResource ToolIcon}" Content="&#xE8BD;" Click="Chat_Click" ToolTip="{Binding T.TipChat}" />
                    <Button Style="{StaticResource ToolIcon}" Content="&#xE121;" Click="Timers_Click" ToolTip="{Binding T.TipTimers}" />
                    <Button x:Name="RestartButton" Style="{StaticResource ToolIcon}" Content="&#xE72C;" Click="Restart_Click" />
                    <ToggleButton x:Name="LockButton" Style="{StaticResource ToolToggle}" Click="Lock_Click" ToolTip="Lock position">
                        <TextBlock x:Name="LockGlyph" Text="&#xE785;" />
                    </ToggleButton>
                    <Button Style="{StaticResource ToolIcon}" Content="&#xE713;" Click="Settings_Click" ToolTip="Settings" />
                    <Slider x:Name="OpacitySlider" Style="{StaticResource GoldSlider}" Width="52" Minimum="0.15" Maximum="1" Margin="5,0,3,0"
                            ValueChanged="Opacity_Changed" VerticalAlignment="Center" ToolTip="Background opacity" />
                    <Button Style="{StaticResource ToolIcon}" Content="&#xE711;" Click="Hide_Click" ToolTip="Hide (Ctrl+Shift+D)" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Effect="{StaticResource TextShadow}">
                    <StackPanel x:Name="LabelPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Ellipse Width="7" Height="7" Margin="0,0,7,0" Fill="{Binding HeaderBrush}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="PulseBegin" Storyboard="{StaticResource Pulse}" />
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="PulseBegin" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding HeaderLabel}" Foreground="{Binding HeaderBrush}" FontSize="10" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Clock}" FontFamily="{StaticResource NumberFont}" FontWeight="Bold" FontSize="17"
                               Foreground="{StaticResource Cream}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Boss HP: a slim bar -->
            <Grid Grid.Row="2" Height="20" Margin="0,6,0,0" Visibility="{Binding HasBoss, Converter={StaticResource VisibleIf}}">
                <Border CornerRadius="6" Background="#230C0F" BorderBrush="#5E1F24" BorderThickness="1" />
                <Border CornerRadius="6" Background="{StaticResource HpFill}" RenderTransformOrigin="0,0.5" Margin="1">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding BossHpFraction}" />
                    </Border.RenderTransform>
                </Border>
                <Border CornerRadius="6,6,0,0" Height="9" VerticalAlignment="Top" Margin="1,1,1,0" Background="#14FFFFFF" IsHitTestVisible="False" />
                <Grid Margin="10,0">
                    <Grid.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.9" Color="Black" />
                    </Grid.Effect>
                    <TextBlock Text="{Binding BossHpText}" FontFamily="{StaticResource NumberFont}" FontWeight="SemiBold" FontSize="12"
                               Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BossPercent}" FontFamily="{StaticResource NumberFont}" FontWeight="SemiBold" FontSize="12"
                               Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Grid>

            <!-- Party (the labels and the rows share their value column widths) -->
            <Grid Grid.Row="3" Margin="0,10,0,0" Grid.IsSharedSizeScope="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column labels (same widths as the rows below) -->
                <Grid x:Name="ColumnLabels" Margin="8,0,14,5" Visibility="{Binding HasData, Converter={StaticResource VisibleIf}}"
                      Effect="{StaticResource TextShadow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource ColRankWidth}" />
                        <ColumnDefinition Width="{DynamicResource ColGlyphWidth}" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Gs" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Cp" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{DynamicResource ColRuleWidth}" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Dps" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Damage" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Share" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="#" Style="{StaticResource ColHeader}" Width="{DynamicResource RowRankSize}" TextAlignment="Center"
                               HorizontalAlignment="Left" ToolTip="{Binding T.TipPlace}" />
                    <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding T.ColPlayer}" Style="{StaticResource ColHeader}" />
                    <TextBlock Grid.Column="3" Text="GS" Style="{StaticResource ColValueHeader}" ToolTip="{Binding T.TipGs}"
                               Visibility="{Binding HasGear, Converter={StaticResource VisibleIf}}" />
                    <TextBlock Grid.Column="4" Text="CP" Style="{StaticResource ColValueHeader}" ToolTip="{Binding T.TipCp}"
                               Visibility="{Binding HasGear, Converter={StaticResource VisibleIf}}" />
                    <TextBlock Grid.Column="7" Text="{Binding T.ColDps}" Style="{StaticResource ColValueHeader}" ToolTip="{Binding T.TipDps}" />
                    <TextBlock Grid.Column="8" Text="{Binding T.ColDamage}" Style="{StaticResource ColValueHeader}" ToolTip="{Binding T.TipDamage}" />
                    <TextBlock Grid.Column="9" Text="{Binding T.ColShare}" Style="{StaticResource ColValueHeader}" ToolTip="{Binding T.TipShare}" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              Padding="10,4,7,0" Margin="-10,-4,-7,0" PreviewMouseWheel="Rows_PreviewMouseWheel">
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" Focusable="False" />
                </ScrollViewer>
                <TextBlock Grid.RowSpan="2" Text="{Binding T.EmptyParty}" FontSize="12"
                           Foreground="#6B7590" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           Visibility="{Binding HasData, Converter={StaticResource VisibleIf}, ConverterParameter=!}" />
            </Grid>

            <!-- Footer -->
            <StackPanel Grid.Row="4" Margin="0,8,0,0">
                <!-- New version on GitHub: a slim banner until it is installed, skipped or closed for this session -->
                <Grid x:Name="UpdateBanner" Margin="0,0,0,8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource UpdateBannerButton}" Click="Update_Click" ToolTip="{Binding T.TipUpdate}">
                        <DockPanel>
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" Click="UpdateBannerClose_Click" Margin="4,0,8,0"
                            VerticalAlignment="Center" ToolTip="{Binding T.UpdateLater}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Status}">
                        <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" Margin="0,0,7,0" />
                        <TextBlock x:Name="FooterText" FontSize="12" Foreground="#B4BCCB" TextTrimming="CharacterEllipsis"
                                   Effect="{StaticResource TextShadow}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                        <!-- Boss timers: always visible, shows the next respawn -->
                        <Button Style="{StaticResource TimersPill}" Click="Timers_Click" ToolTip="{Binding T.TipTimers}" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE121;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,1,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TimersLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <!-- Recurring server events (private branch): Shugo, Rift, siege, reset -->
                        <ItemsControl ItemsSource="{Binding EventLabels}" VerticalAlignment="Center" Margin="6,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource EventPill}" Margin="0,0,6,0" Content="{Binding Text}"
                                            Background="{Binding Fill}" BorderBrush="{Binding Stroke}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{Binding EventMenuNotify, Source={x:Static s:UiText.Current}}" IsCheckable="True" IsChecked="{Binding Notify, Mode=TwoWay}" />
                                                <MenuItem Header="{Binding EventMenuSound, Source={x:Static s:UiText.Current}}" IsCheckable="True" IsChecked="{Binding Sound, Mode=TwoWay}" />
                                                <Separator />
                                                <MenuItem Header="{Binding EventMenuAt10, Source={x:Static s:UiText.Current}}" IsCheckable="True" IsChecked="{Binding At10, Mode=TwoWay}" />
                                                <MenuItem Header="{Binding EventMenuAt5, Source={x:Static s:UiText.Current}}" IsCheckable="True" IsChecked="{Binding At5, Mode=TwoWay}" />
                                                <Separator />
                                                <MenuItem Header="{Binding EventMenuSyncNow, Source={x:Static s:UiText.Current}}" Click="EventSync_Click" IsEnabled="{Binding CanSync}" />
                                                <MenuItem Header="{Binding EventMenuResetSync, Source={x:Static s:UiText.Current}}" Click="EventResetSync_Click" IsEnabled="{Binding CanSync}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Atlas (private branch): the nodes map -->
                        <Button Style="{StaticResource ToolPill}" Click="Atlas_Click" ToolTip="{Binding T.TrayAtlas}" Margin="6,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE707;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,1,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding T.AtlasTitle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolPill}" Click="Top_Click" ToolTip="{Binding T.TrayTop}" Margin="6,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,1,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding T.TopTitle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PricesPill" Style="{StaticResource ToolPill}" Click="Prices_Click" ToolTip="{Binding T.TrayPrices}" Margin="6,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8EC;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,1,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding T.PricesTitle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FooterLink}" Content="{Binding T.OpenFight}" Click="Details_Click" Effect="{StaticResource TextShadow}" />
                        <Button Style="{StaticResource FooterLink}" Click="Segments_Click" Effect="{StaticResource TextShadow}">
                            <TextBlock><Run Text="{Binding T.Fights, Mode=OneWay}" /><Run Text=" " /><Run Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" /></TextBlock>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Resize grip -->
        <Thumb x:Name="ResizeGrip" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5"
               Cursor="SizeNWSE" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                        <Path Data="M12 2 L2 12 M12 6 L6 12 M12 10 L10 12" Stroke="{StaticResource GoldDim}" StrokeThickness="1.3" />
                    </Border>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
