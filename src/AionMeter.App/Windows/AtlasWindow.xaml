<Window x:Class="AionMeter.App.Windows.AtlasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:AionMeter.App.Services"
        Title="{Binding AtlasTitle, Source={x:Static s:UiText.Current}}" Width="900" Height="760" MinWidth="500" MinHeight="400"
        WindowStyle="None" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="{StaticResource Bg0}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}" FontSize="12.5">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource GoldDim}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="18,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE707;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{StaticResource Gold}" VerticalAlignment="Center" Margin="0,2,10,0" />
                    <TextBlock x:Name="TitleText" Text="{Binding AtlasTitle, Source={x:Static s:UiText.Current}}" FontFamily="{StaticResource TitleFont}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="ZoneText" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="14,2,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <CheckBox x:Name="FollowBox" Style="{StaticResource DarkCheck}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0"
                              Content="{Binding AtlasFollow, Source={x:Static s:UiText.Current}}" />
                    <Button Style="{StaticResource Chip}" Height="26" FontSize="12" Margin="0,0,10,0" Content="Fit" Click="Fit_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" Click="Close_Click" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" x:Name="Viewport" ClipToBounds="True" Background="#0B0F18" Margin="1,0"
                    MouseWheel="Viewport_MouseWheel" MouseLeftButtonDown="Viewport_MouseDown" MouseLeftButtonUp="Viewport_MouseUp" MouseMove="Viewport_MouseMove">
                <Grid>
                    <!-- The map at its decoded size under a scale + pan; the data layer is drawn in screen space on top.
                         The Image sits in a Canvas: a Grid cell would lay it out at the window size and Image clips its
                         bitmap to its layout box (measured: only the top-left corner of the map was ever drawn). -->
                    <Canvas>
                    <Image x:Name="MapImage" Stretch="None" RenderOptions.BitmapScalingMode="LowQuality">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="Zoom" />
                                <TranslateTransform x:Name="Pan" />
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    </Canvas>
                    <Canvas x:Name="Overlay" IsHitTestVisible="False" />
                </Grid>
            </Border>
            <TextBlock Grid.Row="2" x:Name="HintText" Margin="18,6,18,10" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextMute}"
                       Text="{Binding AtlasHint, Source={x:Static s:UiText.Current}}" />
        </Grid>
    </Border>
</Window>
