<Window x:Class="AionMeter.App.Windows.NameNodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:AionMeter.App.Services"
        Title="{Binding NameNodeTitle, Source={x:Static s:UiText.Current}}" Width="420" SizeToContent="Height"
        WindowStyle="None" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="{StaticResource Bg0}" Topmost="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}" FontSize="12.5">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource GoldDim}" BorderThickness="1" Padding="18,12,18,16">
        <StackPanel>
            <TextBlock Text="{Binding NameNodeTitle, Source={x:Static s:UiText.Current}}" FontFamily="{StaticResource TitleFont}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock x:Name="Question" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,0,0,12" />
            <TextBlock Text="{Binding NameNodeName, Source={x:Static s:UiText.Current}}" Foreground="{StaticResource TextMute}" FontSize="11" />
            <TextBox x:Name="NameBox" Margin="0,2,0,10" WindowChrome.IsHitTestVisibleInChrome="True" />
            <TextBlock Text="{Binding NameNodeCategory, Source={x:Static s:UiText.Current}}" Foreground="{StaticResource TextMute}" FontSize="11" />
            <ComboBox x:Name="CategoryBox" Margin="0,2,0,14" WindowChrome.IsHitTestVisibleInChrome="True" IsEditable="True">
                <ComboBoxItem Content="mineral" /><ComboBoxItem Content="gem" /><ComboBoxItem Content="wood" /><ComboBoxItem Content="herb" /><ComboBoxItem Content="ingredient" /><ComboBoxItem Content="od" />
            </ComboBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource Chip}" Height="28" MinWidth="80" Margin="0,0,8,0" Content="{Binding NameNodeSkip, Source={x:Static s:UiText.Current}}" Click="Skip_Click" />
                <Button Style="{StaticResource Chip}" Height="28" MinWidth="80" Content="{Binding NameNodeSave, Source={x:Static s:UiText.Current}}" Click="Save_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
