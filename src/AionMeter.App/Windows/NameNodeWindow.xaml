<Window x:Class="AionMeter.App.Windows.NameNodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:AionMeter.App.Services"
        Title="{Binding NameNodeTitle, Source={x:Static s:UiText.Current}}" Width="560" SizeToContent="Height"
        WindowStyle="None" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="{StaticResource Bg0}" Topmost="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}" FontSize="12.5">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource GoldDim}" BorderThickness="1" Padding="18,12,18,16">
        <StackPanel>
            <TextBlock Text="{Binding NameNodeTitle, Source={x:Static s:UiText.Current}}" FontFamily="{StaticResource TitleFont}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock x:Name="Question" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,0,0,10" />
            <!-- One row per category: header + icon buttons; a click saves the kind for this object code -->
            <StackPanel x:Name="Catalog" WindowChrome.IsHitTestVisibleInChrome="True" />
            <!-- The gather this prompt is about, as a countdown chip in the theme's gold, above the Not-now button -->
            <Border x:Name="TimerChip" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="10,3" CornerRadius="4"
                    BorderBrush="{StaticResource Gold}" BorderThickness="1" Background="#26C9A45C" Visibility="Collapsed">
                <TextBlock x:Name="TimerText" Foreground="{StaticResource Gold}" FontWeight="SemiBold" FontSize="13" />
            </Border>
            <DockPanel Margin="0,8,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource Chip}" Height="28" MinWidth="80" Content="{Binding NameNodeSkip, Source={x:Static s:UiText.Current}}" Click="Skip_Click" />
                <TextBox x:Name="NameBox" Margin="0,0,10,0" VerticalContentAlignment="Center" ToolTip="Other (type a name and press Enter)" KeyDown="NameBox_KeyDown" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
