<Window x:Class="AionMeter.App.Windows.PriceWatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:AionMeter.App.Services"
        Title="{Binding PricesTitle, Source={x:Static s:UiText.Current}}" Width="820" Height="420" MinWidth="620" MinHeight="260"
        WindowStyle="None" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="{StaticResource Bg0}"
        Topmost="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}" FontSize="12.5">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1F2E" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource GoldDim}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{StaticResource Gold}" />
        </Style>
        <Style x:Key="Small" TargetType="Button">
            <Setter Property="Foreground" Value="#F3D58F" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="10,4" BorderThickness="1" BorderBrush="#C9A45C" Background="#99111726">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFE3A6" />
                                <Setter TargetName="Bd" Property="Background" Value="#CC1A2235" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource GoldDim}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="18,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8EC;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{StaticResource Gold}"
                               VerticalAlignment="Center" Margin="0,2,10,0" />
                    <TextBlock Text="{Binding PricesTitle, Source={x:Static s:UiText.Current}}" FontFamily="{StaticResource TitleFont}"
                               FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource TextMute}" VerticalAlignment="Center" Margin="14,2,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Small}" Content="{Binding PricesCheckNow, Source={x:Static s:UiText.Current}}" Click="Check_Click" Margin="0,0,10,0" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" Click="Close_Click"
                            ToolTip="{Binding TipClose, Source={x:Static s:UiText.Current}}" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1" Margin="18,0,18,10" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextMute}"
                       Text="{Binding PricesHint, Source={x:Static s:UiText.Current}}" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="14,0,14,6">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0DFFFFFF" BorderBrush="{Binding Frame}" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,0,0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{StaticResource TextMute}" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding MaxText, Mode=OneWay}" Tag="{Binding Watch}"
                                             LostFocus="Max_LostFocus" KeyDown="Max_KeyDown" Margin="6,0" ToolTip="{Binding PricesMax, Source={x:Static s:UiText.Current}}" />
                                    <TextBlock Grid.Column="2" Text="{Binding LastText}" Foreground="{Binding PriceBrush}" FontWeight="SemiBold" FontSize="14"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding Trend}" Foreground="{Binding TrendBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding Listings}" Foreground="{StaticResource TextMute}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <Button Grid.Column="5" Style="{StaticResource IconButton}" Content="&#xE774;" Tag="{Binding Watch}" Click="Open_Click" Margin="6,0,0,0" ToolTip="aion2.exchange" />
                                    <Button Grid.Column="6" Style="{StaticResource IconButton}" Content="&#xE74D;" Tag="{Binding Watch}" Click="Remove_Click" Margin="2,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="18,4,18,14">
                <TextBox x:Name="ItemBox" Style="{StaticResource Field}" Width="130" ToolTip="{Binding PricesItemId, Source={x:Static s:UiText.Current}}" KeyDown="Add_KeyDown" />
                <TextBox x:Name="MaxBox" Style="{StaticResource Field}" Width="130" Margin="8,0,0,0" ToolTip="{Binding PricesMax, Source={x:Static s:UiText.Current}}" KeyDown="Add_KeyDown" />
                <Button Style="{StaticResource Small}" Content="{Binding PricesAdd, Source={x:Static s:UiText.Current}}" Click="Add_Click" Margin="8,0,0,0" />
                <TextBlock x:Name="AddHint" Foreground="{StaticResource TextMute}" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
