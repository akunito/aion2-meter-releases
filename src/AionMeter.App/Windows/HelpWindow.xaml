<Window x:Class="AionMeter.App.Windows.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:AionMeter.Service;assembly=AionMeter.Service"
        Title="{Binding HelpTitle, Source={x:Static s:UiText.Current}}" Width="620" Height="620" MinWidth="440" MinHeight="360"
        WindowStyle="None" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="{StaticResource Bg0}"
        Topmost="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}" FontSize="12.5">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource GoldDim}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="18,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE897;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{StaticResource Gold}" VerticalAlignment="Center" Margin="0,2,10,0" />
                    <TextBlock x:Name="TitleText" FontFamily="{StaticResource TitleFont}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <ComboBox x:Name="LangBox" Width="110" SelectionChanged="Lang_Changed" Margin="0,0,10,0">
                        <ComboBoxItem Content="English" Tag="en" />
                        <ComboBoxItem Content="Español" Tag="es" />
                    </ComboBox>
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" Click="Close_Click" />
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,4,20,16">
                <TextBlock x:Name="Body" TextWrapping="Wrap" LineHeight="20" />
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
