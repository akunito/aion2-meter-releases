<Window x:Class="AionMeter.App.Windows.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:AionMeter.Service;assembly=AionMeter.Service"
        Title="{Binding UpdateTitle, Source={x:Static s:UiText.Current}}" Width="580" Height="560" MinWidth="460" MinHeight="380"
        WindowStyle="None" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="{StaticResource Bg0}"
        Topmost="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}" FontSize="12.5">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource GoldDim}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="18,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{StaticResource Green}"
                               VerticalAlignment="Center" Margin="0,2,10,0" />
                    <TextBlock Text="{Binding UpdateTitle, Source={x:Static s:UiText.Current}}" FontFamily="{StaticResource TitleFont}"
                               FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" Click="Close_Click" HorizontalAlignment="Right"
                        VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="20,0,20,12">
                <TextBlock x:Name="Headline" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource GoldBright}" TextWrapping="Wrap" />
                <TextBlock x:Name="SubLine" Foreground="{StaticResource TextDim}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Release notes, as plain text -->
            <Border Grid.Row="2" Margin="20,0,20,12" Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                    CornerRadius="10" Padding="16,12,8,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding UpdateWhatsNew, Source={x:Static s:UiText.Current}}"
                               Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <TextBlock x:Name="Notes" TextWrapping="Wrap" LineHeight="19" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="3" Margin="20,0,20,12">
                <TextBlock x:Name="Hint" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextMute}" />
                <ProgressBar x:Name="DownloadBar" Height="6" Margin="0,10,0,0" Minimum="0" Maximum="1" Visibility="Collapsed">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" CornerRadius="3" Background="#1AFFFFFF" />
                                <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left" Background="{StaticResource Green}" />
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
                <TextBlock x:Name="State" FontSize="11.5" Foreground="{StaticResource TextDim}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>

            <Border Grid.Row="4" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
                <Grid>
                    <Button x:Name="SkipButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="Skip_Click"
                            Content="{Binding UpdateSkip, Source={x:Static s:UiText.Current}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButton}" Click="Close_Click" Margin="0,0,8,0"
                                Content="{Binding UpdateLater, Source={x:Static s:UiText.Current}}" />
                        <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" Click="Update_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
