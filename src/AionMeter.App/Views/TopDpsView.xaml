<UserControl x:Class="AionMeter.App.Views.TopDpsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:AionMeter.App.Services" Background="{StaticResource Bg0}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}" FontSize="12.5">


    <Border BorderBrush="{StaticResource GoldDim}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="18,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{StaticResource Gold}"
                               VerticalAlignment="Center" Margin="0,2,10,0" />
                    <TextBlock Text="{Binding TopTitle, Source={x:Static s:UiText.Current}}" FontFamily="{StaticResource TitleFont}"
                               FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="CountText" FontSize="12" Foreground="{StaticResource TextMute}" VerticalAlignment="Center" Margin="14,2,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" Click="Close_Click"
                            ToolTip="{Binding TipClose, Source={x:Static s:UiText.Current}}" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="18,0,18,10">
                <StackPanel Orientation="Horizontal" Margin="-4,0,0,2">
                    <RadioButton x:Name="ScopeHistory" Style="{StaticResource TabToggle}" GroupName="TopScope" IsChecked="True" Checked="Scope_Checked" Tag="0"
                                 Content="{Binding TopScopeHistory, Source={x:Static s:UiText.Current}}" />
                    <RadioButton x:Name="ScopeServer" Style="{StaticResource TabToggle}" GroupName="TopScope" Checked="Scope_Checked" Tag="1" />
                    <RadioButton x:Name="ScopeGlobal" Style="{StaticResource TabToggle}" GroupName="TopScope" Checked="Scope_Checked" Tag="2"
                                 Content="{Binding TopScopeGlobal, Source={x:Static s:UiText.Current}}" />
                </StackPanel>
                <ItemsControl x:Name="ClassTabs" Margin="-4,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource TabToggle}" GroupName="TopClass" Content="{Binding Label}" IsChecked="{Binding Selected}"
                                         Checked="Class_Checked" Tag="{Binding Class}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextMute}"
                           Text="{Binding TopHint, Source={x:Static s:UiText.Current}}" />
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="14,0,14,12">
                <Grid>
                    <ItemsControl x:Name="List">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0DFFFFFF" BorderBrush="{Binding FrameBrush}" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,0,0,7">
                                    <StackPanel>
                                        <Grid Background="Transparent" MouseLeftButtonUp="Row_Click" Cursor="Hand">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Rank}" FontFamily="{StaticResource NumberFont}" FontSize="20" FontWeight="Bold"
                                                       Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="6,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding NameBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Meta}" FontSize="11.5" Foreground="{StaticResource TextMute}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Dps}" Foreground="{StaticResource Gold}" HorizontalAlignment="Right"
                                                           FontFamily="{StaticResource NumberFont}" FontSize="19" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Duration}" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,-1,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="3" Style="{StaticResource Chip}" Height="26" FontSize="12" VerticalAlignment="Center" Visibility="{Binding RotationVisibility}"
                                                    Content="{Binding TopOpenFight, Source={x:Static s:UiText.Current}}" Click="Open_Click" />
                                        </Grid>
                                        <Border Visibility="{Binding DetailVisibility}" Margin="40,8,0,0" Padding="0,8,0,0" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0">
                                            <StackPanel>
                                              <StackPanel Visibility="{Binding RotationVisibility}">
                                                <TextBlock Text="{Binding TopSkills, Source={x:Static s:UiText.Current}}" FontSize="11" Foreground="{StaticResource Gold}" Margin="0,0,0,3" />
                                                <TextBlock Text="{Binding SkillsText}" TextWrapping="Wrap" FontSize="12" />
                                                <TextBlock Text="{Binding TopOpening, Source={x:Static s:UiText.Current}}" FontSize="11" Foreground="{StaticResource Gold}" Margin="0,8,0,3" />
                                                <TextBlock Text="{Binding OpeningText}" TextWrapping="Wrap" FontSize="12" />
                                                <TextBlock Text="{Binding TopRepeated, Source={x:Static s:UiText.Current}}" FontSize="11" Foreground="{StaticResource Gold}" Margin="0,8,0,3" />
                                                <TextBlock Text="{Binding RepeatedText}" TextWrapping="Wrap" FontSize="12" />
                                                <TextBlock Text="{Binding TopCadence, Source={x:Static s:UiText.Current}}" FontSize="11" Foreground="{StaticResource Gold}" Margin="0,8,0,3" />
                                                <TextBlock Text="{Binding CadenceText}" TextWrapping="Wrap" FontSize="12" />
                                              </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,3">
                                                    <TextBlock Text="{Binding TopProfile, Source={x:Static s:UiText.Current}}" FontSize="11" Foreground="{StaticResource Gold}" VerticalAlignment="Center" />
                                                    <Button Style="{StaticResource Chip}" Height="22" FontSize="11" Margin="10,0,0,0" Click="Profile_Click"
                                                            Content="{Binding TopProfileFetch, Source={x:Static s:UiText.Current}}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding ProfileText}" TextWrapping="Wrap" FontSize="12" FontFamily="Consolas" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EmptyText" Text="{Binding TopEmpty, Source={x:Static s:UiText.Current}}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextMute}" HorizontalAlignment="Center" TextAlignment="Center" Margin="30,40,30,0" MaxWidth="420" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
