<UserControl x:Class="AionMeter.App.Views.AtlasView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:AionMeter.App.Services" xmlns:v="clr-namespace:AionMeter.App.Views" Background="{StaticResource Bg0}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}" FontSize="12.5">

    <Border BorderBrush="{StaticResource GoldDim}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="18,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="&#xE707;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{StaticResource Gold}" VerticalAlignment="Center" Margin="0,2,10,0" />
                    <TextBlock x:Name="TitleText" Text="{Binding AtlasTitle, Source={x:Static s:UiText.Current}}" FontFamily="{StaticResource TitleFont}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE897;" FontSize="13" Click="Help_Click" Tag="atlas" Margin="8,2,0,0" VerticalAlignment="Center" ToolTip="{Binding TipHelp, Source={x:Static s:UiText.Current}}" />
                    <TextBlock x:Name="ZoneText" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="14,2,0,0" />
                </StackPanel>
                <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ItemsControl x:Name="ZoneToggles" VerticalAlignment="Center" Margin="0,0,16,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Width="28" Height="28" Margin="0,0,3,0" Padding="0" Cursor="Hand" Focusable="False" Tag="{Binding Key}"
                                              IsChecked="{Binding On, Mode=OneWay}" Click="ZoneToggle_Click" ToolTip="{Binding Tip}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bd" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" Background="#22FFFFFF" Padding="2">
                                                <Image Source="{Binding Icon}" Width="20" Height="20" Opacity="0.55" x:Name="Img" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{Binding Brush}" />
                                                    <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF" />
                                                    <Setter TargetName="Img" Property="Opacity" Value="1" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Img" Property="Opacity" Value="1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox x:Name="PetsBox" Style="{StaticResource DarkCheck}" VerticalAlignment="Center" Margin="0,0,14,0" Click="Pets_Click"
                              Content="{Binding AtlasPets, Source={x:Static s:UiText.Current}}" />
                    <CheckBox x:Name="FollowBox" Style="{StaticResource DarkCheck}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0"
                              Content="{Binding AtlasFollow, Source={x:Static s:UiText.Current}}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding AtlasZoom, Source={x:Static s:UiText.Current}}" Foreground="{StaticResource TextDim}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Slider x:Name="ZoomSlider" Width="130" Minimum="-2.53" Maximum="2.48" Value="0" VerticalAlignment="Center" IsMoveToPointEnabled="True" ValueChanged="Zoom_Changed" />
                    </StackPanel>
                    <Button Style="{StaticResource Chip}" Height="26" FontSize="12" Content="{Binding AtlasFit, Source={x:Static s:UiText.Current}}" Click="Fit_Click" />
                </WrapPanel>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" Click="Close_Click" VerticalAlignment="Top" Margin="6,12,0,0" />
            </Grid>
            <Border Grid.Row="1" x:Name="Viewport" ClipToBounds="True" Background="#0B0F18" Margin="1,0"
                    MouseWheel="Viewport_MouseWheel" MouseLeftButtonDown="Viewport_MouseDown" MouseLeftButtonUp="Viewport_MouseUp" MouseMove="Viewport_MouseMove" MouseRightButtonDown="Viewport_RightClick">
                <Grid>
                    <!-- The map at its decoded size under a scale + pan; the data layer is drawn in screen space on top.
                         The Image sits in a Canvas: a Grid cell would lay it out at the window size and Image clips its
                         bitmap to its layout box (measured: only the top-left corner of the map was ever drawn). -->
                    <Canvas>
                    <Image x:Name="MapImage" Stretch="None" RenderOptions.BitmapScalingMode="Linear">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="Zoom" />
                                <TranslateTransform x:Name="Pan" />
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    </Canvas>
                    <!-- Panning moves these two layers with a translate (GPU composite of the retained drawing); they are only
                         redrawn on zoom, data change or a drift past half a viewport (dragging rebuilt the whole canvas per mouse move, 2026-10-11). -->
                    <v:AtlasStaticLayer x:Name="StaticLayer" IsHitTestVisible="False">
                        <v:AtlasStaticLayer.RenderTransform><TranslateTransform x:Name="StaticPan" /></v:AtlasStaticLayer.RenderTransform>
                    </v:AtlasStaticLayer>
                    <Canvas x:Name="Overlay" IsHitTestVisible="False">
                        <Canvas.RenderTransform><TranslateTransform x:Name="OverlayPan" /></Canvas.RenderTransform>
                    </Canvas>
                    <!-- right-click card for a pet marker; a sibling of Overlay so Refresh() does not wipe it (Diego, 2026-10-10) -->
                    <Canvas IsHitTestVisible="False">
                        <Border x:Name="PetInfo" Visibility="Collapsed" Background="#E6121826" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,7" MaxWidth="360">
                            <StackPanel>
                                <TextBlock x:Name="PetInfoTitle" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                                <TextBlock x:Name="PetInfoBody" FontSize="11.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="17" />
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Grid>
            </Border>
            <TextBlock Grid.Row="2" x:Name="HintText" Margin="18,6,18,10" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextMute}"
                       Text="{Binding AtlasHint, Source={x:Static s:UiText.Current}}" />
        </Grid>
    </Border>
</UserControl>
