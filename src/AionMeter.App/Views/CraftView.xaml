<UserControl x:Class="AionMeter.App.Views.CraftView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:AionMeter.App.Services" Background="{StaticResource Bg0}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}" FontSize="12.5">
    <UserControl.Resources>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1F2E" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource GoldDim}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{StaticResource Gold}" />
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="{StaticResource GoldDim}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="18,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{StaticResource Gold}" VerticalAlignment="Center" Margin="0,2,10,0" />
                    <TextBlock Text="{Binding CraftTitle, Source={x:Static s:UiText.Current}}" FontFamily="{StaticResource TitleFont}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource TextMute}" VerticalAlignment="Center" Margin="14,2,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" Click="Close_Click" ToolTip="{Binding TipClose, Source={x:Static s:UiText.Current}}" />
                </StackPanel>
            </Grid>
            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="18,0,18,8">
                <TextBox x:Name="SearchBox" Style="{StaticResource Field}" Width="220" TextChanged="Filter_Changed" ToolTip="{Binding CraftSearch, Source={x:Static s:UiText.Current}}" />
                <ItemsControl x:Name="Professions" Margin="8,0,0,0" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource TabToggle}" GroupName="CraftProf" Content="{Binding Label}" Tag="{Binding Key}" IsChecked="{Binding Selected}" Checked="Profession_Checked" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ComboBox x:Name="ScopeBox" MinWidth="230" VerticalAlignment="Center" Margin="12,0,0,0" SelectionChanged="Scope_Changed" ToolTip="{Binding CraftOnlyNowTip, Source={x:Static s:UiText.Current}}">
                    <ComboBoxItem Content="{Binding CraftScopeNow, Source={x:Static s:UiText.Current}}" Tag="now" />
                    <ComboBoxItem Content="{Binding CraftScopeNear, Source={x:Static s:UiText.Current}}" Tag="near" />
                    <ComboBoxItem Content="{Binding CraftScopeAll, Source={x:Static s:UiText.Current}}" Tag="all" />
                </ComboBox>
                <CheckBox x:Name="ProfitBox" Style="{StaticResource DarkCheck}" VerticalAlignment="Center" Margin="12,0,0,0" Click="Filter_Click"
                          Content="{Binding CraftProfit, Source={x:Static s:UiText.Current}}" ToolTip="{Binding CraftProfitTip, Source={x:Static s:UiText.Current}}" />
                <Button Style="{StaticResource Chip}" Height="26" FontSize="12" Margin="12,0,0,0" Click="LoadMarket_Click" Content="{Binding CraftLoadMarket, Source={x:Static s:UiText.Current}}"
                        ToolTip="{Binding CraftLoadMarketTip, Source={x:Static s:UiText.Current}}" />
            </WrapPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="14,0,14,10">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0DFFFFFF" BorderBrush="{Binding Frame}" BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{StaticResource TextMute}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Times}" Foreground="{Binding TimesBrush}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        <Button Style="{StaticResource IconButton}" Content="{Binding Star}" Foreground="{Binding StarBrush}" FontFamily="Segoe UI Symbol" FontSize="15" Tag="{Binding Output}" Click="Star_Click" Margin="8,0,0,0"
                                                ToolTip="{Binding CraftFavTip, Source={x:Static s:UiText.Current}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
