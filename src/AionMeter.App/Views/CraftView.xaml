<UserControl x:Class="AionMeter.App.Views.CraftView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:AionMeter.App.Services" Background="{StaticResource Bg0}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}" FontSize="12.5">
    <UserControl.Resources>
    </UserControl.Resources>
    <Border BorderBrush="{StaticResource GoldDim}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="18,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{StaticResource Gold}" VerticalAlignment="Center" Margin="0,2,10,0" />
                    <TextBlock Text="{Binding CraftTitle, Source={x:Static s:UiText.Current}}" FontFamily="{StaticResource TitleFont}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE897;" FontSize="13" Click="Help_Click" Tag="craft" Margin="8,2,0,0" VerticalAlignment="Center" ToolTip="{Binding TipHelp, Source={x:Static s:UiText.Current}}" />
                    <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource TextMute}" VerticalAlignment="Center" Margin="14,2,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" Click="Close_Click" ToolTip="{Binding TipClose, Source={x:Static s:UiText.Current}}" />
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Margin="18,0,18,8">
                <WrapPanel Orientation="Horizontal">
                    <Grid Width="250" Height="28" Margin="0,0,10,6">
                        <TextBox x:Name="SearchBox" Style="{StaticResource Field}" Padding="6,3,26,3" TextChanged="Filter_Changed" KeyDown="Search_KeyDown" ToolTip="{Binding CraftSearch, Source={x:Static s:UiText.Current}}" />
                        <Button x:Name="ClearSearch" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                Click="ClearSearch_Click" Visibility="Collapsed" ToolTip="{Binding CraftClear, Source={x:Static s:UiText.Current}}" />
                    </Grid>
                    <ItemsControl x:Name="Professions" VerticalAlignment="Center" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource TabToggle}" GroupName="CraftProf" Content="{Binding Label}" Tag="{Binding Key}" IsChecked="{Binding Selected}" Checked="Profession_Checked" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
                <WrapPanel Orientation="Horizontal">
                    <ComboBox x:Name="ScopeBox" Width="250" Height="28" VerticalAlignment="Center" Margin="0,0,10,0" SelectionChanged="Scope_Changed" ToolTip="{Binding CraftOnlyNowTip, Source={x:Static s:UiText.Current}}">
                        <ComboBoxItem Content="{Binding CraftScopeNow, Source={x:Static s:UiText.Current}}" Tag="now" />
                        <ComboBoxItem Content="{Binding CraftScopeNear, Source={x:Static s:UiText.Current}}" Tag="near" />
                        <ComboBoxItem Content="{Binding CraftScopeAll, Source={x:Static s:UiText.Current}}" Tag="all" />
                    </ComboBox>
                    <CheckBox x:Name="ProfitBox" Style="{StaticResource DarkCheck}" VerticalAlignment="Center" Margin="0,0,10,0" Click="Filter_Click"
                              Content="{Binding CraftProfit, Source={x:Static s:UiText.Current}}" ToolTip="{Binding CraftProfitTip, Source={x:Static s:UiText.Current}}" />
                    <Button Style="{StaticResource Chip}" Height="28" FontSize="12" Click="LoadMarket_Click" Content="{Binding CraftLoadMarket, Source={x:Static s:UiText.Current}}"
                            ToolTip="{Binding CraftLoadMarketTip, Source={x:Static s:UiText.Current}}" />
                </WrapPanel>
            </StackPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="14,0,14,10">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0DFFFFFF" BorderBrush="{Binding Frame}" BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{StaticResource TextMute}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Times}" Foreground="{Binding TimesBrush}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        <Button Style="{StaticResource IconButton}" Content="{Binding Star}" Foreground="{Binding StarBrush}" FontFamily="Segoe UI Symbol" FontSize="15" Tag="{Binding Output}" Click="Star_Click" Margin="8,0,0,0"
                                                ToolTip="{Binding CraftFavTip, Source={x:Static s:UiText.Current}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
