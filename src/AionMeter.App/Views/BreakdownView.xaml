<UserControl x:Class="AionMeter.App.Views.BreakdownView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AionMeter.App.Controls"
        xmlns:s="clr-namespace:AionMeter.App.Services"
        Background="{StaticResource Bg0}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Focusable="True"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        PreviewKeyDown="View_PreviewKeyDown" PreviewMouseDown="View_PreviewMouseDown">
    <UserControl.Resources>
        <!-- table columns that drop out when the view is narrow (ApplyWidth sets them) -->
        <GridLength x:Key="ColAvg">64</GridLength>
        <GridLength x:Key="ColMax">64</GridLength>
        <GridLength x:Key="ColShare">110</GridLength>
        <Thickness x:Key="ShareGap">14,0,0,0</Thickness>
        <GridLength x:Key="ColFront">60</GridLength>
        <GridLength x:Key="ColMulti">60</GridLength>
        <GridLength x:Key="ColAccDamage">78</GridLength>
        <c:VisibleIf x:Key="VisibleIf" />

        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <!-- A column header that sorts its table: gold when it is the sort column, brighter under the mouse. -->
        <Style x:Key="ThButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{StaticResource TextMute}" />
            <EventSetter Event="Click" Handler="SortHead_Click" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,2">
                            <ContentPresenter x:Name="Label" TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontFamily="{StaticResource NumberFont}" TextElement.FontSize="10.5"
                                              TextElement.FontWeight="SemiBold" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource GoldBright}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Td" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource GoldDim}" BorderThickness="1">
        <!-- Wide: the party panel is the left column. Under 760 px it leaves the column and drops down under the header from the
             "Party" toggle (ApplyWidth moves it). -->
        <Grid x:Name="Root">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideColumn" Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Party list -->
            <Border x:Name="SidePanel" Grid.RowSpan="3" Panel.ZIndex="5" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="14,14,14,8">
                        <TextBlock x:Name="AppTitle" Text="AION2 DPS Meter" FontFamily="{StaticResource TitleFont}" FontSize="15" Foreground="{StaticResource Gold}" Margin="0,0,0,10" />
                        <!-- in the overlay: another fight in this view (the overlay's fight list) -->
                        <Button x:Name="FightsButton" Style="{StaticResource Chip}" Height="24" HorizontalAlignment="Left" Margin="0,0,0,10" Visibility="Collapsed"
                                Click="Fights_Click" ToolTip="{Binding TipFightPicker, Source={x:Static s:UiText.Current}}" WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock><Run Text="{Binding Fights, Source={x:Static s:UiText.Current}, Mode=OneWay}" /><Run Text=" &#x25BE;" /></TextBlock>
                        </Button>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:BossPortrait x:Name="FightPortrait" Width="42" Height="42" Margin="0,0,10,0" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="FightTitle" FontSize="12" Foreground="{StaticResource Text}"
                                           TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                <TextBlock x:Name="FightMeta" FontFamily="{StaticResource NumberFont}" FontSize="10.5"
                                           Foreground="{StaticResource TextMute}" TextWrapping="Wrap" />
                                <!-- A2M-38: where your DPS sits among your class on this boss this week (Abyss Logs) -->
                                <TextBlock x:Name="FightRank" FontSize="10.5" Foreground="{StaticResource Gold}" TextWrapping="Wrap"
                                           Margin="0,3,0,0" Visibility="Collapsed" ToolTip="abysslogs.com" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                        <ListBox x:Name="PartyList" Background="Transparent" Foreground="{StaticResource Text}" BorderThickness="0" Margin="6,0,6,6"
                                 SelectionChanged="PartyList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" CornerRadius="6" Padding="8,6" Margin="0,1" Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverFill}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#26C9A45C" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="25" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="19" Height="19" CornerRadius="5" HorizontalAlignment="Left" Background="{Binding Rank.Bg}"
                                                BorderBrush="{Binding Rank.Border}" BorderThickness="1">
                                            <TextBlock Text="{Binding PlaceText}" FontFamily="{StaticResource NumberFont}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{Binding Rank.Fg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <c:ClassGlyph Grid.Column="1" Class="{Binding Class}" Width="19" Height="19" HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12.5" Foreground="{Binding NameBrush}"
                                                   FontWeight="{Binding NameWeight}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding ShareText}" FontFamily="{StaticResource NumberFont}" FontSize="11"
                                                   Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                </DockPanel>
            </Border>

            <!-- Header (caption area of the window: drag to move). Row 1 holds the stat tiles when they do not fit beside the name. -->
            <Grid x:Name="Header" Grid.Column="1" Margin="12,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="64" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="HeaderLeft" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- in the overlay: back to the DPS tab (Esc does the same) -->
                    <Button x:Name="BackButton" Style="{StaticResource Chip}" Height="26" FontSize="12" Margin="0,0,8,0" Visibility="Collapsed"
                            Click="Back_Click" ToolTip="{Binding TipBack, Source={x:Static s:UiText.Current}}" WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,1,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Back, Source={x:Static s:UiText.Current}}" FontFamily="{StaticResource UiFont}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ToggleButton x:Name="PartyToggle" Style="{StaticResource Chip}" Height="26" FontSize="12" Margin="0,0,8,0" Visibility="Collapsed"
                                  Click="PartyToggle_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="{StaticResource UiFont}"><Run Text="{Binding PartyToggle, Source={x:Static s:UiText.Current}, Mode=OneWay}" /><Run Text=" &#x25BE;" /></TextBlock>
                    </ToggleButton>
                </StackPanel>
                <c:ClassGlyph x:Name="HeaderGlyph" Grid.Column="1" Width="40" Height="40" Glow="True" VerticalAlignment="Center" Margin="4,0,0,0" />
                <StackPanel Grid.Column="2" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PlayerName" FontFamily="{StaticResource TitleFont}" FontSize="20" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PlayerMeta" FontFamily="{StaticResource NumberFont}" FontSize="11" Foreground="{StaticResource TextDim}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <!-- Auto columns beside the name; equal star columns on their own row (ApplyWidth) -->
                <Grid x:Name="Tiles" Grid.Column="3" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PlaceTile" Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock x:Name="PlaceLabel" Text="{Binding TilePlace, Source={x:Static s:UiText.Current}}" Style="{StaticResource TileLabel}" />
                            <TextBlock x:Name="StatPlace" Style="{StaticResource TileValue}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="DamageTile" Grid.Column="1" Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock x:Name="DamageLabel" Text="{Binding TileDamage, Source={x:Static s:UiText.Current}}" Style="{StaticResource TileLabel}" />
                            <TextBlock x:Name="StatDamage" Style="{StaticResource TileValue}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="DpsTile" Grid.Column="2" Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock x:Name="DpsLabel" Text="{Binding TileDps, Source={x:Static s:UiText.Current}}" Style="{StaticResource TileLabel}" />
                            <TextBlock x:Name="StatDps" Style="{StaticResource TileValue}" Foreground="{StaticResource GoldBright}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ShareTile" Grid.Column="3" Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock x:Name="ShareLabel" Text="{Binding TileContrib, Source={x:Static s:UiText.Current}}" Style="{StaticResource TileLabel}" />
                            <TextBlock x:Name="StatShare" Style="{StaticResource TileValue}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="TimeTile" Grid.Column="4" Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock x:Name="TimeLabel" Text="{Binding TileTime, Source={x:Static s:UiText.Current}}" Style="{StaticResource TileLabel}" />
                            <TextBlock x:Name="StatTime" Style="{StaticResource TileValue}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <StackPanel x:Name="HeaderButtons" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="ChatButton" Style="{StaticResource IconButton}" Content="&#xE8BD;" Click="CopyChat_Click" ToolTip="{Binding TipChat, Source={x:Static s:UiText.Current}}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" Click="CopyImage_Click" ToolTip="{Binding TipCopyImage, Source={x:Static s:UiText.Current}}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE897;" Click="Help_Click" ToolTip="{Binding TipHelp, Source={x:Static s:UiText.Current}}" />
                    <Button x:Name="MinimizeButton" Style="{StaticResource IconButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="{Binding TipMinimize, Source={x:Static s:UiText.Current}}" />
                    <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE711;" Click="Close_Click" ToolTip="{Binding TipClose, Source={x:Static s:UiText.Current}}" />
                </StackPanel>
            </Grid>

            <!-- Tabs -->
            <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Margin="12,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabDps" Style="{StaticResource TabToggle}" Content="{Binding TabDps, Source={x:Static s:UiText.Current}}" IsChecked="True" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabAccuracy" Style="{StaticResource TabToggle}" Content="{Binding TabAccuracy, Source={x:Static s:UiText.Current}}" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabRotation" Style="{StaticResource TabToggle}" Content="{Binding TabRotation, Source={x:Static s:UiText.Current}}" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabDefense" Style="{StaticResource TabToggle}" Content="{Binding TabDefense, Source={x:Static s:UiText.Current}}" Checked="Tab_Checked" />
                    <!-- A2M-44: only when a profile is known; hidden tabs have no data (ApplyTabs) -->
                    <RadioButton x:Name="TabProfile" Style="{StaticResource TabToggle}" Content="{Binding TabProfile, Source={x:Static s:UiText.Current}}" Checked="Tab_Checked" Visibility="Collapsed" />
                    <RadioButton x:Name="TabSkills" Style="{StaticResource TabToggle}" Content="{Binding TabSkills, Source={x:Static s:UiText.Current}}" Checked="Tab_Checked" Visibility="Collapsed" />
                    <RadioButton x:Name="TabDaev" Style="{StaticResource TabToggle}" Content="{Binding TabDaevanion, Source={x:Static s:UiText.Current}}" Checked="Tab_Checked" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" Grid.Column="1" x:Name="Body" Margin="16,12,16,14">
                <!-- DPS -->
                <Grid x:Name="PageDps">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="170" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border CornerRadius="8" Background="#0CFFFFFF" Padding="4,6,8,2">
                        <Grid>
                            <TextBlock Text="{Binding DpsTimeline, Source={x:Static s:UiText.Current}}" Style="{StaticResource SectionLabel}" Margin="8,0,0,0" />
                            <c:TimelineChart x:Name="Chart" Margin="0,14,0,0" />
                        </Grid>
                    </Border>
                    <Grid x:Name="SkillHead" Grid.Row="1" Margin="8,12,14,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="{DynamicResource ColAvg}" />
                            <ColumnDefinition Width="{DynamicResource ColMax}" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="{DynamicResource ColShare}" />
                        </Grid.ColumnDefinitions>
                        <Button Tag="Name" Style="{StaticResource ThButton}" HorizontalAlignment="Left" />
                        <Button Grid.Column="1" Tag="Hits" Style="{StaticResource ThButton}" />
                        <Button Grid.Column="2" Tag="Damage" Style="{StaticResource ThButton}" />
                        <Button Grid.Column="3" Tag="Dps" Style="{StaticResource ThButton}" />
                        <Button Grid.Column="4" Tag="Average" Style="{StaticResource ThButton}" />
                        <Button Grid.Column="5" Tag="Max" Style="{StaticResource ThButton}" />
                        <Button Grid.Column="6" Tag="Crit" Style="{StaticResource ThButton}" />
                        <Button Grid.Column="7" Tag="Share" Style="{StaticResource ThButton}" />
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SkillList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="30" Margin="0,0,0,2" ToolTip="{Binding Tooltip}">
                                        <Border CornerRadius="6" Background="#0AFFFFFF" />
                                        <Grid Margin="8,0,14,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="78" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="{DynamicResource ColAvg}" />
                                                <ColumnDefinition Width="{DynamicResource ColMax}" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="{DynamicResource ColShare}" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Grid Width="22" Height="22"><Border CornerRadius="4" Background="{Binding Swatch}" /><Image Source="{Binding Icon}" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,22,22" RadiusX="4" RadiusY="4" /></Image.Clip></Image></Grid>
                                                <TextBlock Text="{Binding Name}" Margin="8,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DotTag}" Margin="6,0,0,0" FontSize="10" Foreground="{StaticResource TextMute}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Hits}" Style="{StaticResource Td}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Damage}" Style="{StaticResource Td}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="3" Text="{Binding Dps}" Style="{StaticResource Td}" />
                                            <TextBlock Grid.Column="4" Text="{Binding Avg}" Style="{StaticResource Td}" Foreground="{StaticResource TextDim}" />
                                            <TextBlock Grid.Column="5" Text="{Binding Max}" Style="{StaticResource Td}" Foreground="{StaticResource TextDim}" />
                                            <TextBlock Grid.Column="6" Text="{Binding Crit}" Style="{StaticResource Td}" />
                                            <Grid Grid.Column="7" Margin="{DynamicResource ShareGap}" VerticalAlignment="Center">
                                                <Border Height="5" CornerRadius="2.5" Background="#22FFFFFF" />
                                                <Border Height="5" CornerRadius="2.5" Background="{StaticResource Gold}" HorizontalAlignment="Left"
                                                        Width="{Binding ShareWidth}" />
                                                <TextBlock Text="{Binding Share}" Style="{StaticResource Td}" FontSize="10.5" Margin="0,-16,0,0"
                                                           Foreground="{StaticResource TextDim}" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Accuracy -->
                <Grid x:Name="PageAccuracy" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <UniformGrid x:Name="QualityTiles" Rows="1" Margin="-6,0,0,0" />
                    <Grid x:Name="AccuracyHead" Grid.Row="1" Margin="8,16,14,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="{DynamicResource ColFront}" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="{DynamicResource ColMulti}" />
                            <ColumnDefinition Width="{DynamicResource ColAccDamage}" />
                        </Grid.ColumnDefinitions>
                        <Button Tag="Name" Style="{StaticResource ThButton}" HorizontalAlignment="Left" />
                        <Button Grid.Column="1" Tag="Hits" Style="{StaticResource ThButton}" />
                        <Button Grid.Column="2" Tag="Crit" Style="{StaticResource ThButton}" />
                        <Button Grid.Column="3" Tag="Back" Style="{StaticResource ThButton}" />
                        <Button Grid.Column="4" Tag="Front" Style="{StaticResource ThButton}" />
                        <Button Grid.Column="5" Tag="Perfect" Style="{StaticResource ThButton}" />
                        <Button Grid.Column="6" Tag="Heavy" Style="{StaticResource ThButton}" />
                        <Button Grid.Column="7" Tag="Multi" Style="{StaticResource ThButton}" />
                        <Button Grid.Column="8" Tag="Damage" Style="{StaticResource ThButton}" />
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AccuracyList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="28" Margin="0,0,0,2">
                                        <Border CornerRadius="6" Background="#0AFFFFFF" />
                                        <Grid Margin="8,0,14,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="{DynamicResource ColFront}" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="{DynamicResource ColMulti}" />
                                                <ColumnDefinition Width="{DynamicResource ColAccDamage}" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Grid Width="18" Height="18"><Border CornerRadius="4" Background="{Binding Swatch}" /><Image Source="{Binding Icon}" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,18,18" RadiusX="4" RadiusY="4" /></Image.Clip></Image></Grid>
                                                <TextBlock Text="{Binding Name}" Margin="8,0,0,0" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Hits}" Style="{StaticResource Td}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Crit}" Style="{StaticResource Td}" />
                                            <TextBlock Grid.Column="3" Text="{Binding Back}" Style="{StaticResource Td}" />
                                            <TextBlock Grid.Column="4" Text="{Binding Front}" Style="{StaticResource Td}" />
                                            <TextBlock Grid.Column="5" Text="{Binding Perfect}" Style="{StaticResource Td}" />
                                            <TextBlock Grid.Column="6" Text="{Binding Heavy}" Style="{StaticResource Td}" />
                                            <TextBlock Grid.Column="7" Text="{Binding Multi}" Style="{StaticResource Td}" />
                                            <TextBlock Grid.Column="8" Text="{Binding Damage}" Style="{StaticResource Td}" Foreground="{StaticResource TextDim}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Rotation -->
                <Grid x:Name="PageRotation" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="RotationHint" Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="0,0,0,10"
                               Text="{Binding RotationHint, Source={x:Static s:UiText.Current}}" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <c:RotationStrip x:Name="Rotation" Margin="0,0,8,0" />
                    </ScrollViewer>
                </Grid>

                <!-- A2M-44: profile pages (ProfilePages builds them) and the status line while a profile loads or failed -->
                <ScrollViewer x:Name="PageProfile" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                <ScrollViewer x:Name="PageSkills" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                <ScrollViewer x:Name="PageDaev" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                <TextBlock x:Name="ProfileStatus" Visibility="Collapsed" Foreground="{StaticResource TextDim}" FontSize="12.5" TextWrapping="Wrap" Margin="2,6,0,0" />

                <!-- Defense -->
                <StackPanel x:Name="PageDefense" Visibility="Collapsed">
                    <UniformGrid x:Name="DefenseTiles" Rows="1" Margin="-6,0,0,0" HorizontalAlignment="Left" />
                    <TextBlock Margin="0,16,0,0" Foreground="{StaticResource TextMute}" FontSize="11.5" TextWrapping="Wrap"
                               Text="{Binding DefNote, Source={x:Static s:UiText.Current}}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
