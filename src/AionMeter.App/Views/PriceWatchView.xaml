<UserControl x:Class="AionMeter.App.Views.PriceWatchView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:AionMeter.App.Services" Background="{StaticResource Bg0}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}" FontSize="12.5">

    <UserControl.Resources>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1F2E" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource GoldDim}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <Grid>
                                <TextBlock x:Name="Hint" Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ToolTip}" Foreground="#5F6778" FontSize="{TemplateBinding FontSize}"
                                           Margin="7,0,4,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value="" />
                                    <Condition Property="IsKeyboardFocused" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="CaretBrush" Value="{StaticResource Gold}" />
        </Style>
        <Style x:Key="Small" TargetType="Button">
            <Setter Property="Foreground" Value="#F3D58F" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="10,4" BorderThickness="1" BorderBrush="#C9A45C" Background="#99111726">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFE3A6" />
                                <Setter TargetName="Bd" Property="Background" Value="#CC1A2235" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource GoldDim}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="18,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8EC;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{StaticResource Gold}"
                               VerticalAlignment="Center" Margin="0,2,10,0" />
                    <TextBlock Text="{Binding PricesTitle, Source={x:Static s:UiText.Current}}" FontFamily="{StaticResource TitleFont}"
                               FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource TextMute}" VerticalAlignment="Center" Margin="14,2,40,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" Click="Close_Click"
                            ToolTip="{Binding TipClose, Source={x:Static s:UiText.Current}}" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1" Margin="18,0,18,10" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextMute}"
                       Text="{Binding PricesHint, Source={x:Static s:UiText.Current}}" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="14,0,14,6">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0DFFFFFF" BorderBrush="{Binding Frame}" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,0,0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" ToolTip="{Binding AltTip}" />
                                        <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{StaticResource TextMute}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBox Style="{StaticResource Field}" Width="54" Text="{Binding QtyText, Mode=OneWay}" Tag="{Binding Watch}" LostFocus="Holding_LostFocus" KeyDown="Holding_KeyDown"
                                                     ToolTip="{Binding PricesQty, Source={x:Static s:UiText.Current}}" FontSize="11" />
                                            <TextBox Style="{StaticResource Field}" Width="84" Text="{Binding PaidText, Mode=OneWay}" Tag="{Binding Watch}" LostFocus="Holding_LostFocus" KeyDown="Holding_KeyDown"
                                                     ToolTip="{Binding PricesPaid, Source={x:Static s:UiText.Current}}" FontSize="11" Margin="4,0,0,0" />
                                            <TextBlock Text="{Binding ValueText}" Foreground="{Binding ValueBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource Small}" Content="{Binding ModeText}" Tag="{Binding Watch}" Click="Mode_Click" Margin="6,0,0,0" Padding="0"
                                            ToolTip="{Binding PricesSell, Source={x:Static s:UiText.Current}}" VerticalAlignment="Center" Width="30" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Field}" Text="{Binding MaxText, Mode=OneWay}" Tag="{Binding Watch}" VerticalAlignment="Center"
                                             LostFocus="Max_LostFocus" KeyDown="Max_KeyDown" Margin="4,0" ToolTip="{Binding PricesMax, Source={x:Static s:UiText.Current}}" />
                                    <TextBlock Grid.Column="3" Text="{Binding LastText}" Foreground="{Binding PriceBrush}" FontWeight="SemiBold" FontSize="14"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0" />
                                    <TextBlock Grid.Column="4" Text="{Binding Trend}" Foreground="{Binding TrendBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{Binding Listings}" Foreground="{StaticResource TextMute}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <Button Grid.Column="6" Style="{StaticResource IconButton}" Content="&#xE774;" Tag="{Binding Watch}" Click="Open_Click" Margin="6,0,0,0" ToolTip="aion2.exchange" />
                                    <Button Grid.Column="7" Style="{StaticResource IconButton}" Content="&#xE74D;" Tag="{Binding Watch}" Click="Remove_Click" Margin="2,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Margin="18,4,18,0">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="SearchBox" Style="{StaticResource Field}" Width="300" TextChanged="Search_TextChanged" KeyDown="Search_KeyDown"
                             ToolTip="{Binding PricesSearch, Source={x:Static s:UiText.Current}}" />
                    <RadioButton x:Name="LangEn" Style="{StaticResource TabToggle}" GroupName="PriceLang" Content="EN" Margin="8,0,0,0" Checked="Lang_Checked" Tag="en"
                                 ToolTip="{Binding PricesSearchLang, Source={x:Static s:UiText.Current}}" />
                    <RadioButton x:Name="LangEs" Style="{StaticResource TabToggle}" GroupName="PriceLang" Content="ES" Checked="Lang_Checked" Tag="es"
                                 ToolTip="{Binding PricesSearchLang, Source={x:Static s:UiText.Current}}" />
                    <TextBlock x:Name="SearchHint" Foreground="{StaticResource TextMute}" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <ListBox x:Name="Results" MaxHeight="170" Margin="0,4,0,0" Visibility="Collapsed" Background="#1A1F2E" BorderBrush="{StaticResource GoldDim}" BorderThickness="1"
                         Foreground="{StaticResource Text}" MouseLeftButtonUp="Result_Click" KeyDown="Result_KeyDown" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" />
                                <TextBlock Grid.Column="1" Text="{Binding Id}" Foreground="{StaticResource TextMute}" Margin="12,0,4,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
            <WrapPanel Grid.Row="4" Orientation="Horizontal" Margin="18,6,18,14">
                <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                    <TextBox x:Name="ItemBox" Style="{StaticResource Field}" Width="130" ToolTip="{Binding PricesItemId, Source={x:Static s:UiText.Current}}" KeyDown="Add_KeyDown" />
                    <TextBox x:Name="MaxBox" Style="{StaticResource Field}" Width="130" Margin="8,0,0,0" ToolTip="{Binding PricesMax, Source={x:Static s:UiText.Current}}" KeyDown="Add_KeyDown" />
                    <CheckBox x:Name="SellBox" Style="{StaticResource DarkCheck}" Content="{Binding PricesSell, Source={x:Static s:UiText.Current}}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <Button Style="{StaticResource Small}" Content="{Binding PricesAdd, Source={x:Static s:UiText.Current}}" Click="Add_Click" Margin="8,0,0,0" />
                    <TextBlock x:Name="AddHint" Foreground="{StaticResource TextMute}" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Style="{StaticResource Small}" Content="{Binding PricesCopyMarket, Source={x:Static s:UiText.Current}}" Click="CopyMarket_Click" Margin="0,0,6,0"
                            ToolTip="{Binding PricesCopyTip, Source={x:Static s:UiText.Current}}" />
                    <Button Style="{StaticResource Small}" Content="{Binding PricesCopyItems, Source={x:Static s:UiText.Current}}" Click="CopyItems_Click" Margin="0,0,6,0"
                            ToolTip="{Binding PricesCopyTip, Source={x:Static s:UiText.Current}}" />
                    <Button x:Name="CheckButton" Style="{StaticResource Small}" Content="{Binding PricesCheckNow, Source={x:Static s:UiText.Current}}" Click="Check_Click" MinWidth="110" />
                </StackPanel>
            </WrapPanel>
        </Grid>
    </Border>
</UserControl>
