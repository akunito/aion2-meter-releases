<UserControl x:Class="AionMeter.App.Views.PriceWatchView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:AionMeter.App.Controls"
        xmlns:s="clr-namespace:AionMeter.App.Services" Background="{StaticResource Bg0}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}" FontSize="12.5">

    <UserControl.Resources>
        <!-- grade chip after an item name (GradeTag): same-named items differ only by grade -->
        <DataTemplate DataType="{x:Type c:GradeTag}">
            <Border Background="{Binding Back}" BorderBrush="{Binding Line}" BorderThickness="0.8" CornerRadius="3" Padding="4,0,4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Text}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding Fore}" />
            </Border>
        </DataTemplate>
        <Style x:Key="Small" TargetType="Button">
            <Setter Property="Foreground" Value="#F3D58F" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="10,4" BorderThickness="1" BorderBrush="#C9A45C" Background="#99111726">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFE3A6" />
                                <Setter TargetName="Bd" Property="Background" Value="#CC1A2235" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 24h / 7 days / 30 days switch of the expanded row's chart -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Padding="10,3" BorderThickness="1" BorderBrush="#6E5A33" Background="#66111726" CornerRadius="{TemplateBinding Tag}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55C9A45C" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C9A45C" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource GoldBright}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource GoldDim}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="18,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8EC;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{StaticResource Gold}"
                               VerticalAlignment="Center" Margin="0,2,10,0" />
                    <TextBlock Text="{Binding PricesTitle, Source={x:Static s:UiText.Current}}" FontFamily="{StaticResource TitleFont}"
                               FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE897;" FontSize="13" Click="Help_Click" Tag="prices" Margin="8,2,0,0" VerticalAlignment="Center" ToolTip="{Binding TipHelp, Source={x:Static s:UiText.Current}}" />
                    <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource TextMute}" VerticalAlignment="Center" Margin="14,2,40,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" Click="Close_Click"
                            ToolTip="{Binding TipClose, Source={x:Static s:UiText.Current}}" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1" Margin="18,0,18,10" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextMute}"
                       Text="{Binding PricesHint, Source={x:Static s:UiText.Current}}" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="14,0,14,6">
                <ItemsControl x:Name="List" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0DFFFFFF" BorderBrush="{Binding Frame}" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,0,0,7"
                                    MouseLeftButtonUp="Row_Click" Cursor="Hand">
                              <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="160" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Hold" />
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Max" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Price" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Trend" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Count" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- DockPanel, not a horizontal StackPanel: the name trims inside the column so the grade chip stays visible on a narrow card -->
                                    <DockPanel VerticalAlignment="Center" LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Chevron}" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource TextMute}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                   ToolTip="{Binding PricesExpandTip, Source={x:Static s:UiText.Current}}" />
                                        <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel VerticalAlignment="Center">
                                            <DockPanel LastChildFill="True" HorizontalAlignment="Left">
                                                <ContentPresenter DockPanel.Dock="Right" Content="{Binding GradeChip}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" ToolTip="{Binding NameTip}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{StaticResource TextMute}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                    <!-- holdings (units, paid each, value) in their own column so every control of the row sits on one line (Diego, 2026-10-11) -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBox Style="{StaticResource Field}" Width="54" Text="{Binding QtyText, Mode=OneWay}" Tag="{Binding Watch}" LostFocus="Holding_LostFocus" KeyDown="Holding_KeyDown"
                                                     ToolTip="{Binding PricesQty, Source={x:Static s:UiText.Current}}" FontSize="11" />
                                            <TextBox Style="{StaticResource Field}" Width="84" Text="{Binding PaidText, Mode=OneWay}" Tag="{Binding Watch}" LostFocus="Holding_LostFocus" KeyDown="Holding_KeyDown"
                                                     ToolTip="{Binding PricesPaid, Source={x:Static s:UiText.Current}}" FontSize="11" Margin="4,0,0,0" />
                                            <TextBlock Text="{Binding ValueText}" Foreground="{Binding ValueBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource Small}" Content="{Binding ModeText}" Tag="{Binding Watch}" Click="Mode_Click" Margin="6,0,0,0" Padding="0"
                                            ToolTip="{Binding PricesSell, Source={x:Static s:UiText.Current}}" VerticalAlignment="Center" Width="30" />
                                    <TextBox Grid.Column="3" Style="{StaticResource Field}" Text="{Binding MaxText, Mode=OneWay}" Tag="{Binding Watch}" VerticalAlignment="Center"
                                             LostFocus="Max_LostFocus" KeyDown="Max_KeyDown" Margin="4,0" ToolTip="{Binding PricesMax, Source={x:Static s:UiText.Current}}" />
                                    <TextBlock Grid.Column="4" Text="{Binding LastText}" Foreground="{Binding PriceBrush}" FontWeight="SemiBold" FontSize="14"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,6,0" MinWidth="84" TextAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="{Binding Trend}" Foreground="{Binding TrendBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="64" TextAlignment="Center" Margin="4,0" />
                                    <TextBlock Grid.Column="6" Text="{Binding Listings}" Foreground="{StaticResource TextMute}" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="40" TextAlignment="Right" Margin="4,0,6,0" />
                                    <Button Grid.Column="7" Style="{StaticResource IconButton}" Content="&#xE774;" Tag="{Binding Watch}" Click="Open_Click" Margin="6,0,0,0" ToolTip="aion2.exchange" />
                                    <Button Grid.Column="8" Style="{StaticResource IconButton}" Content="&#xE74D;" Tag="{Binding Watch}" Click="Remove_Click" Margin="2,0,0,0" />
                                </Grid>
                                <!-- built only for the one expanded row (BuildDetail): listings + chart -->
                                <ContentPresenter Content="{Binding Detail}" />
                              </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Margin="18,4,18,0">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="SearchBox" Style="{StaticResource Field}" Width="300" TextChanged="Search_TextChanged" KeyDown="Search_KeyDown"
                             ToolTip="{Binding PricesSearch, Source={x:Static s:UiText.Current}}" />
                    <RadioButton x:Name="LangEn" Style="{StaticResource TabToggle}" GroupName="PriceLang" Content="EN" Margin="8,0,0,0" Checked="Lang_Checked" Tag="en"
                                 ToolTip="{Binding PricesSearchLang, Source={x:Static s:UiText.Current}}" />
                    <RadioButton x:Name="LangEs" Style="{StaticResource TabToggle}" GroupName="PriceLang" Content="ES" Checked="Lang_Checked" Tag="es"
                                 ToolTip="{Binding PricesSearchLang, Source={x:Static s:UiText.Current}}" />
                    <TextBlock x:Name="SearchHint" Foreground="{StaticResource TextMute}" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <ListBox x:Name="Results" MaxHeight="170" Margin="0,4,0,0" Visibility="Collapsed" Background="#1A1F2E" BorderBrush="{StaticResource GoldDim}" BorderThickness="1"
                         Foreground="{StaticResource Text}" MouseLeftButtonUp="Result_Click" KeyDown="Result_KeyDown" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Main}" />
                                    <ContentPresenter Content="{Binding GradeChip}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Alt}" Foreground="{StaticResource TextMute}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Id}" Foreground="{StaticResource TextMute}" Margin="12,0,4,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
            <WrapPanel Grid.Row="4" Orientation="Horizontal" Margin="18,6,18,4">
                <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                    <TextBox x:Name="ItemBox" Style="{StaticResource Field}" Width="130" ToolTip="{Binding PricesItemId, Source={x:Static s:UiText.Current}}" KeyDown="Add_KeyDown" />
                    <TextBox x:Name="MaxBox" Style="{StaticResource Field}" Width="130" Margin="8,0,0,0" ToolTip="{Binding PricesMax, Source={x:Static s:UiText.Current}}" KeyDown="Add_KeyDown" />
                    <CheckBox x:Name="SellBox" Style="{StaticResource DarkCheck}" Content="{Binding PricesSell, Source={x:Static s:UiText.Current}}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <Button Style="{StaticResource Small}" Content="{Binding PricesAdd, Source={x:Static s:UiText.Current}}" Click="Add_Click" Margin="8,0,0,0" />
                    <TextBlock x:Name="AddHint" Foreground="{StaticResource TextMute}" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </WrapPanel>
            <!-- the three actions in their own row, bottom-right; they wrap inside the row when the card is narrow (Diego, 2026-10-10) -->
            <WrapPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,0,18,12">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Style="{StaticResource Small}" Content="{Binding PricesCopyMarket, Source={x:Static s:UiText.Current}}" Click="CopyMarket_Click" Margin="0,0,6,0"
                            ToolTip="{Binding PricesCopyTip, Source={x:Static s:UiText.Current}}" />
                    <Button Style="{StaticResource Small}" Content="{Binding PricesCopyItems, Source={x:Static s:UiText.Current}}" Click="CopyItems_Click" Margin="0,0,6,0"
                            ToolTip="{Binding PricesCopyTip, Source={x:Static s:UiText.Current}}" />
                    <Button x:Name="CheckButton" Style="{StaticResource Small}" Content="{Binding PricesCheckNow, Source={x:Static s:UiText.Current}}" Click="Check_Click" MinWidth="110" />
                </StackPanel>
            </WrapPanel>
        </Grid>
    </Border>
</UserControl>
