<UserControl x:Class="AionMeter.App.Views.BuildView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:AionMeter.App.Services" Background="#0D0D0D" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI" Foreground="#FAFAFA" FontSize="13">
    <!-- The approved mock is docs/mockups/build-tab/index.html in the project repo (questlog's planner look): colours and sizes follow its CSS -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="BText" Color="#FAFAFA" />
        <SolidColorBrush x:Key="BDim" Color="#AFAFAF" />
        <SolidColorBrush x:Key="BMute" Color="#7D7D7D" />
        <SolidColorBrush x:Key="BBlue" Color="#65B0FC" />
        <SolidColorBrush x:Key="BLine" Color="#2B2B2B" />
        <SolidColorBrush x:Key="BLine2" Color="#373737" />
        <SolidColorBrush x:Key="BBtn" Color="#2B2B2B" />
        <SolidColorBrush x:Key="BCard" Color="#CC1F1F1F" />
        <SolidColorBrush x:Key="BBand" Color="#1F1F1F" />
        <SolidColorBrush x:Key="BAmber" Color="#F5B544" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource BLine}" />
            <Setter Property="BorderThickness" Value="0.8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Band" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BBand}" />
            <Setter Property="CornerRadius" Value="8,8,0,0" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style x:Key="BandTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource BDim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- questlog's sub-tab buttons: transparent until chosen, then #2b2b2b with a #373737 frame -->
        <Style x:Key="SubTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource BDim}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0.8" CornerRadius="6" Padding="12,6">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2B2B2B" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#373737" />
                                <Setter Property="Foreground" Value="#FAFAFA" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FAFAFA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Flat" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BText}" />
            <Setter Property="Background" Value="{StaticResource BBtn}" />
            <Setter Property="BorderBrush" Value="{StaticResource BLine2}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0.8" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5A5A5A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#7D7D7D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- text-only button (Clear, + Add macro, the footer's save) -->
        <Style x:Key="TextBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BMute}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Margin="2,0" VerticalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FAFAFA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlueCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource BText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="14" Height="14" CornerRadius="3" BorderThickness="1" BorderBrush="#5A5A5A" Background="#1F1F1F" VerticalAlignment="Center">
                                <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Foreground="#0D0D0D"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" />
                            </Border>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#65B0FC" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#65B0FC" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="{StaticResource BBtn}" />
            <Setter Property="BorderBrush" Value="{StaticResource BLine2}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <!-- mock .slider: 6 px #2b2b2b track, blue fill, 18 px white knob -->
        <Style x:Key="LevelSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20" Background="Transparent">
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"><Border Height="6" CornerRadius="3,0,0,3" Background="#65B0FC" /></Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"><Border Height="6" CornerRadius="0,3,3,0" Background="#2B2B2B" /></Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb"><Ellipse Width="18" Height="18" Fill="White" /></ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- skill tooltip: mock .tip (340 px, #141414, #373737 frame, radius 8) -->
        <Style x:Key="SkillTip" TargetType="ToolTip">
            <Setter Property="Foreground" Value="#FAFAFA" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#141414" BorderBrush="#373737" BorderThickness="0.8" CornerRadius="8" Padding="10" Width="340">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="#2B2B2B" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- sub-tabs | skill language, help, close -->
            <Grid Margin="14,10,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="SubSkills" Style="{StaticResource SubTab}" GroupName="BuildSub" IsChecked="True" Checked="Sub_Checked"
                                 Content="{Binding BuildSubSkills, Source={x:Static s:UiText.Current}}" />
                    <RadioButton x:Name="SubDaev" Style="{StaticResource SubTab}" GroupName="BuildSub" Checked="Sub_Checked"
                                 Content="{Binding BuildSubDaevanion, Source={x:Static s:UiText.Current}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ComboBox x:Name="LangBox" Width="140" Margin="0,0,6,0" SelectionChanged="Lang_Changed" ToolTip="{Binding BuildSkillLangTip, Source={x:Static s:UiText.Current}}">
                        <ComboBoxItem Content="Skills: English" Tag="en" />
                        <ComboBoxItem Content="Skills: Español" Tag="es" />
                    </ComboBox>
                    <Button Style="{StaticResource IconButton}" Content="&#xE897;" FontSize="13" Click="Help_Click" Tag="build" ToolTip="{Binding TipHelp, Source={x:Static s:UiText.Current}}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" Click="Close_Click" ToolTip="{Binding TipClose, Source={x:Static s:UiText.Current}}" />
                </StackPanel>
            </Grid>

            <!-- build picker row -->
            <DockPanel Grid.Row="1" Margin="14,10,14,0" LastChildFill="True">
                <ComboBox x:Name="BuildBox" Width="320" SelectionChanged="BuildBox_Changed" ToolTip="{Binding BuildPickTip, Source={x:Static s:UiText.Current}}" />
                <Button Style="{StaticResource Flat}" Margin="6,0,0,0" Height="28" Click="NewFromProfile_Click" Content="{Binding BuildNewFromProfile, Source={x:Static s:UiText.Current}}"
                        ToolTip="{Binding BuildNewFromProfileTip, Source={x:Static s:UiText.Current}}" />
                <Button Style="{StaticResource Flat}" Margin="6,0,0,0" Height="28" Click="Import_Click" Content="{Binding BuildImport, Source={x:Static s:UiText.Current}}"
                        ToolTip="{Binding BuildImportTip, Source={x:Static s:UiText.Current}}" />
                <Button x:Name="CopyQuestlog" Style="{StaticResource Flat}" Margin="6,0,0,0" Height="28" Click="CopyQuestlog_Click" Content="{Binding BuildCopyQuestlog, Source={x:Static s:UiText.Current}}"
                        ToolTip="{Binding BuildCopyQuestlogTip, Source={x:Static s:UiText.Current}}" />
                <Button x:Name="DeleteBuild" Style="{StaticResource IconButton}" Margin="4,0,0,0" Content="&#xE74D;" FontSize="12" Click="DeleteBuild_Click"
                        ToolTip="{Binding BuildDeleteTip, Source={x:Static s:UiText.Current}}" />
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource BMute}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <ScrollViewer x:Name="Scroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,10,0,0">
                <Grid Margin="14,0,14,14">
                    <!-- ===== Skills & Stigmas ===== -->
                    <StackPanel x:Name="PageSkills">
                        <!-- no active build: the class's most-liked questlog builds instead of an empty planner -->
                        <Border x:Name="SuggestCard" Style="{StaticResource Card}" Visibility="Collapsed">
                            <StackPanel>
                                <Border Style="{StaticResource Band}">
                                    <TextBlock x:Name="SuggestTitle" Style="{StaticResource BandTitle}" />
                                </Border>
                                <TextBlock FontSize="12.5" Foreground="{StaticResource BDim}" TextWrapping="Wrap" Margin="12,10,12,10" Text="{Binding BuildSuggestHint, Source={x:Static s:UiText.Current}}" />
                                <StackPanel x:Name="SuggestList" Margin="12,0,12,4" />
                                <StackPanel Orientation="Horizontal" Margin="12,6,12,12">
                                    <Button Style="{StaticResource Flat}" Height="28" Click="Import_Click" Content="{Binding BuildSearch, Source={x:Static s:UiText.Current}}" />
                                    <Button Style="{StaticResource Flat}" Height="28" Margin="6,0,0,0" Click="NewFromProfile_Click" Content="{Binding BuildNewFromProfile, Source={x:Static s:UiText.Current}}"
                                            ToolTip="{Binding BuildNewFromProfileTip, Source={x:Static s:UiText.Current}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="BuildCards">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource Band}">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource BandTitle}" Text="{Binding BuildCard, Source={x:Static s:UiText.Current}}" />
                                        <TextBlock x:Name="SourceLine" FontSize="12" Foreground="{StaticResource BMute}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="16,0,0,0" />
                                    </DockPanel>
                                </Border>
                                <WrapPanel Margin="12,10,12,0">
                                    <CheckBox x:Name="ShowDone" Style="{StaticResource BlueCheck}" FontSize="12.5" Margin="0,0,16,0" Click="ShowDone_Click"
                                              Content="{Binding BuildShowDone, Source={x:Static s:UiText.Current}}" />
                                    <TextBlock x:Name="MissingText" FontSize="12.5" Foreground="{StaticResource BAmber}" VerticalAlignment="Center" />
                                </WrapPanel>
                                <TextBlock x:Name="TargetText" FontSize="11.5" Foreground="{StaticResource BMute}" HorizontalAlignment="Right" Margin="12,4,12,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="NoClassText" FontSize="12.5" Foreground="{StaticResource BMute}" Margin="12,12,12,4" TextWrapping="Wrap" Visibility="Collapsed"
                                           Text="{Binding BuildNoClass, Source={x:Static s:UiText.Current}}" />
                                <StackPanel Orientation="Horizontal" Margin="12,10,12,6">
                                    <TextBlock Style="{StaticResource Lbl}" Text="ACTIVE" x:Name="LblActive" />
                                </StackPanel>
                                <WrapPanel x:Name="RowActive" Margin="12,0,6,4" />
                                <StackPanel Orientation="Horizontal" Margin="12,6,12,6">
                                    <TextBlock Style="{StaticResource Lbl}" Text="STIGMA" x:Name="LblStigma" />
                                    <Border Background="#3A3A3A" CornerRadius="4" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="StigmaCount" FontSize="11" Foreground="#A979CB" />
                                    </Border>
                                </StackPanel>
                                <WrapPanel x:Name="RowStigma" Margin="12,0,6,4" />
                                <StackPanel Orientation="Horizontal" Margin="12,6,12,6">
                                    <TextBlock Style="{StaticResource Lbl}" Text="PASSIVE" x:Name="LblPassive" />
                                </StackPanel>
                                <WrapPanel x:Name="RowPassive" Margin="12,0,6,4" />
                                <WrapPanel Margin="12,2,12,10" TextBlock.FontSize="11" TextBlock.Foreground="{StaticResource BMute}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="#3DDC84" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding BuildLegendOk, Source={x:Static s:UiText.Current}}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="#F5B544" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding BuildLegendNear, Source={x:Static s:UiText.Current}}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="#FF5C5C" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding BuildLegendFar, Source={x:Static s:UiText.Current}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding BuildLegendOff, Source={x:Static s:UiText.Current}}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- key bar + detail -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Margin="12,10,12,8" HorizontalAlignment="Left">
                                    <Canvas x:Name="Bar" Width="642" Height="210" HorizontalAlignment="Left" Background="Transparent" />
                                    <Grid x:Name="KeyRow" Width="642" Height="18" Margin="0,6,0,0" HorizontalAlignment="Left" />
                                </StackPanel>
                                <Grid Margin="12">
                                    <TextBlock x:Name="DetailHint" FontSize="12.5" Foreground="{StaticResource BMute}" TextWrapping="Wrap" Text="{Binding BuildPickSkill, Source={x:Static s:UiText.Current}}" />
                                    <StackPanel x:Name="Detail" Visibility="Collapsed">
                                        <DockPanel>
                                            <Grid x:Name="DetailIconHost" Width="48" Height="48" VerticalAlignment="Center" />
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" VerticalAlignment="Center" Click="DetailClose_Click"
                                                    ToolTip="{Binding TipClose, Source={x:Static s:UiText.Current}}" />
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="DetailName" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock x:Name="DetailSub" FontSize="12" Foreground="{StaticResource BBlue}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Grid Margin="0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="EquipButton" Style="{StaticResource Flat}" FontSize="13" Padding="8" Click="Equip_Click" />
                                            <Button x:Name="RemoveButton" Grid.Column="1" Style="{StaticResource Flat}" FontSize="13" Padding="12,8" Margin="6,0,0,0" Click="RemoveSkill_Click"
                                                    Content="{Binding BuildRemove, Source={x:Static s:UiText.Current}}" />
                                        </Grid>
                                        <TextBlock x:Name="DetailDesc" FontSize="12" Foreground="{StaticResource BDim}" TextWrapping="Wrap" LineHeight="18.6" LineStackingStrategy="BlockLineHeight" />
                                        <DockPanel x:Name="LevelBlock" Margin="0,12,0,4">
                                            <TextBlock DockPanel.Dock="Right" x:Name="LevelValue" FontSize="13" FontWeight="Bold" />
                                            <TextBlock FontSize="13" Text="{Binding BuildLevel, Source={x:Static s:UiText.Current}}" />
                                        </DockPanel>
                                        <Slider x:Name="LevelSlider" Style="{StaticResource LevelSlider}" Minimum="1" Maximum="20" Margin="4,4,4,0" ValueChanged="Level_Changed" />
                                        <UniformGrid x:Name="Ticks" Rows="1" Margin="0,4,0,12" />
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock DockPanel.Dock="Right" x:Name="SpecCount" FontSize="13" Foreground="{StaticResource BMute}" />
                                            <TextBlock FontSize="13" Text="{Binding BuildSpecs, Source={x:Static s:UiText.Current}}" />
                                        </DockPanel>
                                        <StackPanel x:Name="SpecList" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- priority -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource Band}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource TextBtn}" Click="ClearPriority_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                <TextBlock Text="{Binding BuildClear, Source={x:Static s:UiText.Current}}" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Style="{StaticResource BandTitle}" Text="{Binding BuildPriority, Source={x:Static s:UiText.Current}}" />
                                    </DockPanel>
                                </Border>
                                <Grid x:Name="PrioActiveRow" Margin="12,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PrioActiveLbl" Style="{StaticResource Lbl}" Text="ACTIVE" />
                                    <WrapPanel x:Name="PrioActive" Grid.Column="1" />
                                </Grid>
                                <Border Height="0.8" Background="{StaticResource BLine}" />
                                <Grid Margin="12,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PrioStigmaLbl" Style="{StaticResource Lbl}" Text="STIGMA" />
                                    <WrapPanel x:Name="PrioStigma" Grid.Column="1" />
                                </Grid>
                                <Border Height="0.8" Background="{StaticResource BLine}" />
                                <Grid Margin="12,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PrioPassiveLbl" Style="{StaticResource Lbl}" Text="PASSIVE" />
                                    <WrapPanel x:Name="PrioPassive" Grid.Column="1" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- macros -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource Band}">
                                    <TextBlock Style="{StaticResource BandTitle}" Text="{Binding BuildMacros, Source={x:Static s:UiText.Current}}" />
                                </Border>
                                <WrapPanel x:Name="MacroList" Margin="12,10,12,6" />
                                <StackPanel x:Name="MacroEditor" Orientation="Horizontal" Margin="12,0,12,10" Visibility="Collapsed">
                                    <TextBox x:Name="MacroName" Style="{StaticResource Field}" Width="150" Height="26" Background="#1F1F1F" BorderBrush="#373737"
                                             ToolTip="{Binding BuildMacroName, Source={x:Static s:UiText.Current}}" />
                                    <TextBlock x:Name="MacroSteps" FontSize="12.5" Foreground="{StaticResource BDim}" VerticalAlignment="Center" Margin="10,0" MaxWidth="420" TextTrimming="CharacterEllipsis" />
                                    <Button Style="{StaticResource Flat}" Height="26" Padding="8,2" Click="MacroAddStep_Click" Content="{Binding BuildMacroAddStep, Source={x:Static s:UiText.Current}}" />
                                    <Button Style="{StaticResource Flat}" Height="26" Padding="8,2" Margin="6,0,0,0" Click="MacroSave_Click" Content="{Binding BuildMacroSave, Source={x:Static s:UiText.Current}}" />
                                    <Button Style="{StaticResource TextBtn}" Margin="8,0,0,0" Click="MacroCancel_Click" Content="{Binding BuildMacroCancel, Source={x:Static s:UiText.Current}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- description (collapsed until the band is clicked) -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Border Style="{StaticResource Band}" Cursor="Hand" MouseLeftButtonUp="Description_Toggle" x:Name="DescBand">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" x:Name="DescChevron" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource BMute}" VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource BandTitle}" Text="{Binding BuildDescription, Source={x:Static s:UiText.Current}}" />
                                    </DockPanel>
                                </Border>
                                <TextBlock x:Name="DescText" Margin="12,10" FontSize="12.5" Foreground="{StaticResource BDim}" TextWrapping="Wrap" LineHeight="19" LineStackingStrategy="BlockLineHeight" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <Button Style="{StaticResource TextBtn}" FontSize="13" Click="SaveNow_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding BuildSave, Source={x:Static s:UiText.Current}}" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="SavedText" FontSize="13" Foreground="{StaticResource BMute}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- ===== Daevanion (phase 4) ===== -->
                    <v:DaevanionView x:Name="PageDaev" xmlns:v="clr-namespace:AionMeter.App.Views" Visibility="Collapsed" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
